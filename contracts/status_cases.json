{
  "$comment": "Vetores golden de calculate_status, compartilhados pelos testes do backend (Python) e do mobile (Dart). Os horarios ja chegam normalizados (vazio => null), como apos normalize_times.",
  "cases": [
    {
      "name": "trabalho com os quatro horarios",
      "day_type": "trabalho",
      "times": { "arrival": "07:45", "lunch_start": "12:00", "lunch_end": "13:00", "departure": "14:45" },
      "expected": "complete"
    },
    {
      "name": "trabalho com apenas a entrada",
      "day_type": "trabalho",
      "times": { "arrival": "07:45", "lunch_start": null, "lunch_end": null, "departure": null },
      "expected": "incomplete"
    },
    {
      "name": "trabalho faltando a saida final",
      "day_type": "trabalho",
      "times": { "arrival": "07:45", "lunch_start": "12:00", "lunch_end": "13:00", "departure": null },
      "expected": "incomplete"
    },
    {
      "name": "trabalho sem nenhum horario",
      "day_type": "trabalho",
      "times": { "arrival": null, "lunch_start": null, "lunch_end": null, "departure": null },
      "expected": "incomplete"
    },
    {
      "name": "atividade teorica sem horarios",
      "day_type": "atividade_teorica",
      "times": { "arrival": null, "lunch_start": null, "lunch_end": null, "departure": null },
      "expected": "not_worked"
    },
    {
      "name": "folga sem horarios",
      "day_type": "folga",
      "times": { "arrival": null, "lunch_start": null, "lunch_end": null, "departure": null },
      "expected": "not_worked"
    },
    {
      "name": "compensacao sem horarios",
      "day_type": "compensacao",
      "times": { "arrival": null, "lunch_start": null, "lunch_end": null, "departure": null },
      "expected": "not_worked"
    },
    {
      "name": "folga com os quatro horarios lancados",
      "day_type": "folga",
      "times": { "arrival": "07:45", "lunch_start": "12:00", "lunch_end": "13:00", "departure": "14:45" },
      "expected": "complete"
    },
    {
      "name": "feriado com horario parcial",
      "day_type": "feriado",
      "times": { "arrival": "08:00", "lunch_start": null, "lunch_end": null, "departure": null },
      "expected": "incomplete"
    },
    {
      "name": "outro sem horarios",
      "day_type": "outro",
      "times": { "arrival": null, "lunch_start": null, "lunch_end": null, "departure": null },
      "expected": "not_worked"
    }
  ]
}
