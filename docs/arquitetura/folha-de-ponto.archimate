<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Folha de Ponto Pessoal v2 (app offline)" id="id-ab894d08012043ccafa3e4889781f431" version="5.0.0">
  <folder name="Strategy" id="id-9f3af104ac8d45408f090c2b9351cf83" type="strategy">
    <folder name="A. Vision" id="id-3cbd6437211049bb9b884f84cac2c15b">
      <element xsi:type="archimate:CourseOfAction" name="Reescrever como app Python offline no celular" id="id-400e10e11a894e86a6bdff9830891223">
        <documentation>Uma pilha só (Python + uv + SQLite + Flet), rodando no aparelho do Trabalhador.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Registro de jornada" id="id-2bcfbc3d6969420db4a826762d22b62b">
        <documentation>Anotar marcações e classificar o dia.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Calendário de feriados e emendas" id="id-103f8e3ceb644e5bb72a3cb48fe92965">
        <documentation>Feriados oficiais (lib pronta) + emendas e datas de Cubatão (sob medida).</documentation>
        <property key="subdominio DDD" value="Generic (lib holidays) + Supporting (emendas, municipais)" />
      </element>
      <element xsi:type="archimate:Capability" name="Fechamento da folha do mês" id="id-2e2b3ae52bca43bda3f2f18f324fb3af">
        <documentation>Conferir pendências e copiar a folha.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Proteção dos dados" id="id-a0aeb2d7f39f457a97884db333b4ef53">
        <documentation>Backup e restauração.</documentation>
        <property key="subdominio DDD" value="Supporting" />
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-2ec5c2653899425f8e9a1aef59edc956" type="business">
    <folder name="B. Business" id="id-fd2c4fe920d342aaa40bae13ed2c2137">
      <element xsi:type="archimate:BusinessActor" name="Trabalhador" id="id-8df297f0aedf45b4b86946613aaf406e">
        <documentation>Aprendiz que registra o próprio ponto. Único usuário do app.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Empresa" id="id-4df1d90c507f42e4abf8094a14c4d2c0">
        <documentation>Empregadora. Recebe a folha de ponto assinada.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Responsável pelo ponto" id="id-f8e4748e2e0e414cb12ab8a6900d6074">
        <documentation>Anota, confere e preenche a própria folha.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Recebedor da folha" id="id-ca61f6396b6a487ba018a04aa564bbc7">
        <documentation>Recebe e arquiva a folha do mês.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Chegada, almoço ou saída" id="id-8db5835daa9e4897a640d08dc55d8826">
        <documentation>Cada um dos momentos que geram uma marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Fim do mês" id="id-aa31105509414a1bb40a6ea80e0b0330">
        <documentation>Hora de preencher e entregar a folha oficial.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Folha de ponto oficial (papel)" id="id-dc862be190aa4f758e6492cd647306f8">
        <documentation>Uma linha por dia (01–31) com Manhã, Tarde e Extra (entrada/saída) e assinatura. Jornada 07:45–12:00 e 13:00–14:45.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Entregar a folha assinada" id="id-4524c776dcd640109dc6b67c350c97fb">
        <documentation>Igual na baseline e no target (keep).</documentation>
      </element>
    </folder>
    <folder name="B. 2 Baseline" id="id-54164c5d272f4dcea63adcb9f62eb27d">
      <element xsi:type="archimate:BusinessObject" name="Mensagens com horários (WhatsApp)" id="id-e26b3abaa10b4b01802a692236c998f0">
        <documentation>Anotações soltas, sem estrutura.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Calendário de cabeça / internet" id="id-24f42833f08142878ebba2750ba44d85">
        <documentation>Onde se descobre, no fim do mês, o que foi feriado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B1 Anotar horário no WhatsApp" id="id-d84ed3c1eeb1432281231516baf6446e">
        <documentation>Mensagem para si mesmo a cada marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B2 Rolar as conversas do mês" id="id-6adc8392507649859dc76614473b621c">
        <documentation>Garimpar as mensagens, dia por dia.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B3 Descobrir feriados e emendas" id="id-43b0a696ae4844c4bbb6eba4f2d198c2">
        <documentation>Lembrar ou pesquisar quais dias não eram úteis.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B4 Preencher a folha à mão" id="id-0c690f9e2402470481ddeea62b621ef4">
        <documentation>Copiar o que foi garimpado para o papel.</documentation>
      </element>
    </folder>
    <folder name="B. 3 Target" id="id-c77575ce744e4d8da718c2173709abab">
      <element xsi:type="archimate:BusinessObject" name="Registro do dia" id="id-f5c0d629f0af40118ac876e374472bc7">
        <documentation>Data, tipo do dia, marcações Manhã/Tarde/Extra, observação e status (completo, incompleto, não trabalhado).</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T1 Bater o ponto no app" id="id-ce80c50198164abfae7ac1eb68ff49f5">
        <documentation>Um toque grava a hora na próxima marcação vazia.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T2 Confirmar feriados e emendas sugeridos" id="id-aadfc22427ec408ba305e0352c78ff2f">
        <documentation>O app sugere; o Trabalhador confirma. Emenda confirmada = folga.</documentation>
        <property key="caso de uso" value="UC03, UC10" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T3 Resolver as pendências do mês" id="id-46f0e79b0cc847398c81393e143d0b8d">
        <documentation>Completar os dias úteis sem lançamento ou incompletos.</documentation>
        <property key="caso de uso" value="UC05, UC07" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T4 Copiar a folha pela tela Folha" id="id-b0109365829e4eccbfe3b244febb1ddc">
        <documentation>Uma linha por dia, na ordem do papel. Marca cada linha copiada.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T6 Guardar o backup do mês" id="id-05866047bf8e4dd4a1d0f8e3ab980ac1">
        <documentation>Gerar o arquivo e guardá-lo fora do celular.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
    </folder>
  </folder>
  <folder name="Application" id="id-b22d94d1e5c34a72b71bb46751f04d93" type="application">
    <folder name="C. 2 Baseline" id="id-1b2a0ae3e3a84fefb0cfbc190a450226">
      <element xsi:type="archimate:ApplicationComponent" name="API Django + DRF" id="id-b1fb0893763a4912bb306baf165386ef">
        <documentation>src/backend: views → serializers → services → repositories, X-Api-Key.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Web React/Vite" id="id-604c006d9e8541a19a4f1e4d803ee407">
        <documentation>src/web: abas Hoje/Mês, calendário, tela de chave de API.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="App Flutter (sqflite)" id="id-129b4666d3ce449b8e835f6ac274d7f1">
        <documentation>src/mobile: offline, regras portadas para Dart, adapter HTTP opcional.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Orquestrador multi-CLI" id="id-5ec05f1c97c24ce4ab0a29609538f529">
        <documentation>orchestrator.sh (2 cópias): Claude Code builder + Antigravity auditor, agents/, skills/.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Gerador de contratos (Py/TS/Dart)" id="id-9250399e7a474114a72ea6fef16716d9">
        <documentation>contracts/generate.py escreve 3 alvos a partir de time_record.json.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="db.sqlite3 do servidor" id="id-cb1a937311614665a5d02384869667e6">
        <documentation>Banco do Django, no celular-servidor.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="folha_de_ponto.db do Flutter" id="id-85501b5cbc3c4fc0a080793a5e6f07d0">
        <documentation>Banco independente do app Flutter, sem sync.</documentation>
      </element>
    </folder>
    <folder name="C. 3 Target" id="id-8dac916da90b4565a6d4d3b79bad1e55">
      <element xsi:type="archimate:ApplicationComponent" name="App Folha de Ponto (pacote folha_ponto)" id="id-ef88b9d863c847d2a758fa7960d35bd9">
        <documentation>Um único pacote Python. Roda no celular (APK Flet) e no PC (uv run).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Interface (Flet)" id="id-79335b4bf5bd48aaad227ed71ffa547f">
        <documentation>servicos.py orquestra os casos de uso sem Flet (testável); telas/ Hoje, Mês, Folha, Ajustes e o formulário do dia são finas e recebem um Contexto, não a Page.</documentation>
        <property key="modulo" value="folha_ponto/ui/" />
        <property key="subdominio DDD" value="Generic (framework Flet)" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Domínio: regras do dia" id="id-216c23049ec54d4da9c392840f6c44ab">
        <documentation>Status, validação HH:MM e ordem das marcações, horas e saldo, pendências e folha do mês. Python puro.</documentation>
        <property key="modulo" value="folha_ponto/dominio/" />
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Calendário: feriados e emendas" id="id-aa69a651f09349d2be54759a43dec509">
        <documentation>Gera o ano pela lib holidays (BR/UF, public + optional; UF desconhecida cai nos nacionais), aplica a regra de emenda (RN05, inclusive na virada do ano) sobre feriados, facultativos e datas manuais, e grava pelo Repositório. Confirma/descarta emendas (UC03) e cadastra datas manuais (UC10).</documentation>
        <property key="modulo" value="folha_ponto/calendario/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Repositório SQLite" id="id-adf81281c6bb4ccb83edbb948cba9fa4">
        <documentation>sqlite3 da stdlib, migrações por PRAGMA user_version, transações atômicas e trava para as threads do Flet. Único que fala SQL. Implementa a porta Calendario.</documentation>
        <property key="modulo" value="folha_ponto/dados/" />
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Exportação e backup" id="id-3645d21722d7457a9297411013162068">
        <documentation>Python puro: folha em texto/CSV (;) na ordem do papel; backup JSON versionado (formato + versão) validado antes de gravar. A restauração (substituir ou mesclar pelo updated_at) é uma transação única do Repositório.</documentation>
        <property key="modulo" value="folha_ponto/exportacao/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Biblioteca holidays (Calendário oficial do Brasil)" id="id-5b9f3385c7f24901b33adfb80a42c5c8">
        <documentation>Dependência open source, offline. Ator secundário do UC06.</documentation>
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Telas Hoje · Mês · Folha · Ajustes" id="id-9972c6caa8524fe39d4c336159c14369">
        <documentation>O que o Trabalhador toca.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Registrar marcação" id="id-418e22eaba5a4050895b1b64ed2a1d28">
        <documentation>Serviço que atende UC01, UC02, UC04.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Consultar mês" id="id-0af1869f24d847c29042fa7ced2e9cdd">
        <documentation>Serviço que atende UC05.</documentation>
        <property key="caso de uso" value="UC05" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Sugerir feriados e emendas" id="id-82b7fc52ce2f4c1e917d6d044c290dad">
        <documentation>Serviço que atende UC03, UC06, UC10.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Listar pendências do mês" id="id-e13806357e4c476f8a9158944cbfd4aa">
        <documentation>Serviço que atende UC07.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Gerar folha para cópia" id="id-a86b4a9b245240078ef4ef26bd47100d">
        <documentation>Serviço que atende UC08.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Backup e restauração" id="id-335543aa66d34aaea1cfedaa4c28be50">
        <documentation>Serviço que atende UC09.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Configurar preferências" id="id-50b3db3be52341c997963304c320688d">
        <documentation>Serviço que atende UC11.</documentation>
        <property key="caso de uso" value="UC11" />
      </element>
    </folder>
    <folder name="C. Dados" id="id-b38812c3404946a09922ea1b7df3898c">
      <element xsi:type="archimate:DataObject" name="Lançamento do dia (tabela lancamentos)" id="id-613937d97ace4fb7bc627922413f6988">
        <documentation>data (única), tipo, entrada, saida_almoco, volta_almoco, saida, entrada_extra, saida_extra, observacao, criado_em, atualizado_em.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Data especial (tabela datas_especiais)" id="id-6ff8a6763056451bae418494224fc49c">
        <documentation>data, nome, natureza (feriado, facultativo, emenda, emenda_sugerida), origem (nacional, estadual, facultativo, regra_emenda, manual), recorrente, oculta, fonte (versão da lib).</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Preferências (tabela preferencias)" id="id-450582d32dba42be88cdd612e299e972">
        <documentation>UF, município, jornada padrão, facultativo conta como folga (padrão: sim), tema.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Vocabulário do domínio (vocabulario.py)" id="id-85701299c27145daaaca032e5c045f18">
        <documentation>Enums TipoDia, Status e Marcacao: fonte única dos termos. Sucede o contracts/time_record.json da v1.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Arquivo de backup (JSON)" id="id-b531da80ea0c4397a234ee4c1139cec3">
        <documentation>Versionado; lançamentos, datas manuais, emendas confirmadas, preferências.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Folha do mês (texto/CSV)" id="id-8d1122aa30b24fc1b3bbb8c1ecc8a975">
        <documentation>Mesma ordem de colunas do papel.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-0ba0d55981184f72801885a4c076ed72" type="technology">
    <folder name="D. 2 Baseline" id="id-4404f4ec43174e7a9ceb6f90a0d8da58">
      <element xsi:type="archimate:Device" name="Celular velho (Termux + sshd)" id="id-71761c53534642aab1fcea5c108b3cae">
        <documentation>Servidor Django na Wi-Fi de casa, porta 8000. Sai do projeto.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC na rede de casa (WSL2)" id="id-64f20ddc417a46d8a0c7186ec9047c66">
        <documentation>Build do frontend e deploy por SSH (scripts/deploy-celular.sh).</documentation>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="Wi-Fi de casa" id="id-64dc4efac3fd47638ce6f5ae436a0b88">
        <documentation>Única rede onde o app atual funciona.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Docker + MongoDB + Caddy" id="id-dc6fb0babdbd43b3bf51d632db9b97b6">
        <documentation>Restos do plano original. Nunca usados pelo código atual.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (Django, Flutter, contratos)" id="id-bb3e62b2bd364fa09268bbf93b7b220d">
        <documentation>3 workflows.</documentation>
      </element>
    </folder>
    <folder name="D. 3 Target" id="id-915a6d1ed09d4e8daea81e1c1f437429">
      <element xsi:type="archimate:Device" name="Celular Android do Trabalhador" id="id-f2149bcd3e334412b628c9d058d12a44">
        <documentation>O mesmo aparelho que vai no bolso. Nada roda fora dele.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Android" id="id-04c215d48e2b49fea388749381c1b452">
        <documentation>Sem permissão INTERNET no manifest.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Python embarcado (Flet)" id="id-6aa228a6edba41e8961e2fdafc8689a3">
        <documentation>Runtime Python empacotado no APK pelo flet build.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="SQLite (sqlite3 da stdlib)" id="id-e2d710d80fea43dca794ee9d99a5a7a9">
        <documentation>Banco embutido, arquivo único.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Armazenamento privado do app" id="id-e47401e75b7446f9bfb646e986dacec3">
        <documentation>Diretório de dados do app, apagado só na desinstalação.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Compartilhamento do Android" id="id-d0a7c78df7ca4002a6a50a0d67625e64">
        <documentation>Menu Compartilhar: salvar, WhatsApp, e-mail, Drive.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha-de-ponto.apk" id="id-169b73ce24744d5e9eace9447bb8bc9a">
        <documentation>Gerado por `uv run flet build apk` no CI (.github/workflows/ci.yml); sem a permissão INTERNET (RNF01), conferido com aapt2.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha_de_ponto.db" id="id-53ec8ecfde2d4deaa8d38c813c9b01ce">
        <documentation>Arquivo SQLite com lancamentos, datas_especiais e preferencias. Pasta: FLET_APP_STORAGE_DATA.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="backup-AAAA-MM-DD.json" id="id-ee18dc552270437e902b1d71c40f8594">
        <documentation>Arquivo de backup que o usuário guarda fora do celular.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC de desenvolvimento" id="id-a9a4a6b19e76489aa5bd26c76543a23e">
        <documentation>Onde se programa, testa e gera o APK.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="uv + Python 3.12" id="id-8d8dd20f84274407aa32594cc44538c2">
        <documentation>uv sync, uv run, uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="pytest" id="id-5e7a13afd80940a1adbe36dd5a9e8f78">
        <documentation>Testes do domínio, do calendário e do SQLite, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (pytest + build APK)" id="id-948d419b02bc4591987d49adacfdd7bb">
        <documentation>Um workflow só.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="Pacote folha_ponto (pyproject.toml + uv.lock)" id="id-462a6d52f3a444e29245cf8771e4f23d">
        <documentation>Código-fonte versionado no git.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyProcess" name="Gerar o APK" id="id-bcd9ecbfb3a543d4b6d350091f006420">
        <documentation>flet build apk a partir do pacote.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Motivation" id="id-78ed36d19ad34869ba56a1ba773181d2" type="motivation">
    <folder name="0. Preliminar" id="id-5113a3830fd143b0b81a1bd57370f1cb">
      <element xsi:type="archimate:Principle" name="Offline primeiro (local-first)" id="id-76efa4bb60d8437c84f85f5f1a242a25">
        <documentation>O app funciona sem rede, em qualquer lugar. Nenhum caminho de uso depende de servidor ou internet.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Simplicidade antes de generalidade" id="id-7e58c7beb3f645afb195b0c16ff12064">
        <documentation>Uma única pilha e um único banco. Só se adiciona peça quando um caso de uso precisa dela.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Uma linguagem: Python com uv" id="id-4785bb7610f84144b09ac302b3246454">
        <documentation>Regras, persistência, calendário e interface em Python. Dependências fixadas em pyproject.toml + uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Regras testáveis sem interface" id="id-b9a50da9973c457fbce87e952acb9a1e">
        <documentation>Domínio e calendário em Python puro, testados com pytest no PC, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Dados do usuário no aparelho e sob controle dele" id="id-df59222e13134730bc26b43bbf365cfa">
        <documentation>Os lançamentos ficam no SQLite do app. O backup é um arquivo que o próprio usuário guarda.</documentation>
      </element>
    </folder>
    <folder name="A. Vision" id="id-d11879fdf9074b47bc021b5b02e8d803">
      <element xsi:type="archimate:Stakeholder" name="Trabalhador (aprendiz)" id="id-e56a57e2f0bb4295839e04e2341acd31">
        <documentation>Dono da folha de ponto. Anota os horários todo dia e preenche a folha oficial no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Empresa (RH / supervisor)" id="id-e7607bda7e1c4878a5d0634fe67a0be0">
        <documentation>Recebe a folha de ponto preenchida e assinada no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Horários espalhados no WhatsApp" id="id-b1bf1403729e4759a268976442c931e9">
        <documentation>Entrada, almoço, volta e saída ficam em mensagens soltas ao longo de semanas.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Rede da empresa bloqueia APIs externas" id="id-156f1549d845404ea38926a9660014b4">
        <documentation>No trabalho não dá para depender de servidor em casa nem de API na internet.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Feriados e emendas esquecidos" id="id-3d42b39f71fb4fdba4102e807c6715b0">
        <documentation>No fim do mês é preciso lembrar quais dias foram feriado, ponto facultativo ou emenda.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Complexidade acidental do repositório" id="id-4f77e1ae2e2a4cfe80686b317373649c">
        <documentation>Django, React, Flutter, orquestrador multi-CLI e restos de MongoDB convivem para um app de uma pessoa.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Folha oficial correta e no prazo" id="id-ed4116c7897e40a0ab21fa4e866fcbbb">
        <documentation>A empresa precisa da folha de papel preenchida, sem lacunas, no fim de cada mês.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Fim do mês exige garimpar conversas" id="id-df67ca0aba4f45cfb8282ba850ed6d2a">
        <documentation>Juntar os horários vira um trabalho à parte, repetitivo e sujeito a erro (README).</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="App atual depende de servidor na rede de casa" id="id-9f51aa1549ff4f1da2b6715443a2ed82">
        <documentation>O web-app roda num celular velho com Termux; fora de casa, não abre.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Regras duplicadas em Python e Dart" id="id-85d0e09879e4407788f8d9346afc04d5">
        <documentation>calculate_status existe em services.py e em status.dart, mantidos juntos por vetores golden.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Sem backup dos dados" id="id-4343c4f5df7f4e81bca3f0adfedfc2d1">
        <documentation>Perder ou trocar o celular perde o histórico (consequência registrada no ADR-001).</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Preencher a folha do mês sem garimpo" id="id-93bdb52c3b4642a787b3eb8a4e32481e">
        <documentation>Ter tudo do mês num só lugar, na ordem da folha de papel.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Registrar o ponto na hora, em segundos" id="id-077f6b1db0944511a45dda193b078205">
        <documentation>A anotação acontece no momento do evento, com um toque.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Funcionar em qualquer rede, sem internet" id="id-bef1cfa4ed4143278ef5c6458b8d41c5">
        <documentation>Inclusive dentro da rede da empresa.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Manter o projeto simples de evoluir" id="id-fe8f948db18b497ca3aa715297c7168c">
        <documentation>Uma pilha, poucos arquivos, testes rápidos. Fácil de estudar e de mudar.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Não perder o histórico" id="id-d7675cbd5c674c64a58c80b2e8201910">
        <documentation>O usuário consegue guardar e restaurar os próprios dados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Folha copiada numa só sessão" id="id-7da0362d44404b5cb64c90f82622f49c">
        <documentation>Sem abrir o WhatsApp nem consultar outro calendário.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Nenhum dia útil esquecido" id="id-ab561456b63e47cd8b99db089a1e0f7c">
        <documentation>O app aponta todo dia útil sem lançamento ou incompleto.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Ponto batido no momento em que acontece" id="id-f54ada7696964b10b33f155e5e44ff82">
        <documentation>Em até 2 toques a partir do ícone do app.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Bater o ponto em até 2 toques" id="id-31e035993da346329b1b2f54b690aba8">
        <documentation>UC01, RNF04.</documentation>
        <property key="caso de uso" value="UC01" />
      </element>
      <element xsi:type="archimate:Requirement" name="Sugerir feriados e emendas automaticamente" id="id-bee0e28e6a9d4d95b2cf8b27b0a2f0b2">
        <documentation>Nacionais e de SP pela lib holidays; Cubatão e emendas da empresa cadastrados. Emenda = folga.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:Requirement" name="Listar as pendências do mês" id="id-3b8f5be2cd1844d499eca5b7228c858b">
        <documentation>Dia útil sem lançamento, lançamento incompleto, emenda a confirmar.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:Requirement" name="Mostrar o mês na ordem da folha de papel" id="id-71249d7ab839436b98f8a4e31cbc2030">
        <documentation>DIA · Manhã E/S · Tarde E/S · Extra E/S · observação, dias 01 a 31 corridos.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar hora extra" id="id-c1094fda05ef4a6e952a44e4cedc1ebc">
        <documentation>Par de marcações Extra (entrada/saída), como na folha oficial.</documentation>
        <property key="caso de uso" value="UC01, UC02" />
      </element>
      <element xsi:type="archimate:Requirement" name="Backup e restauração por arquivo" id="id-61e08af3cbe44d2f80d23134f5be1518">
        <documentation>JSON versionado, mesclar ou substituir.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:Constraint" name="APK sem permissão de internet" id="id-95e59aca86cf4e1e82a5a8e098eb7abd">
        <documentation>RNF01. Um teste reprova qualquer import de rede.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Python ≥ 3.12 gerenciado com uv" id="id-b3daf7ee60904ddb8b7262cb43a51b6c">
        <documentation>RNF02. Decisão do usuário.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Folha oficial em papel, preenchida à mão" id="id-6ec056f4beac43a2a4087359f3173993">
        <documentation>O app não substitui a folha: ele organiza o que vai ser copiado para ela.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-697399a0c377470e9e7c5b5625f7548a" type="implementation_migration">
    <folder name="E-F. Roadmap" id="id-b44cf40495484731b4e38fd8f8020872">
      <element xsi:type="archimate:Plateau" name="Baseline (nov/2026)" id="id-88a34be062ec4f499048acd684af1d4b">
        <documentation>Três pilhas, servidor no celular velho, rede de casa.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 1: núcleo Python testado" id="id-dac43ef6777e46fd8c64b06e614b67e2">
        <documentation>Domínio, calendário e SQLite com pytest; uma CLI mínima no PC já registra e mostra a folha.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 2: app Flet no PC" id="id-5ac93b5b49eb41e6a4712770d2bb3236">
        <documentation>Mesmas telas do celular rodando com `uv run`.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Target: APK offline no celular" id="id-eeb3901835b944cab2c12fd52c275bf7">
        <documentation>App instalado, sem rede, com backup.</documentation>
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar servidor, API e API key" id="id-a8c9f9f73fda4ecdb58be262e7a1b17c">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar React, Flutter e regras em Dart" id="id-dd3526fa32fb4d329a00d7a230f81d70">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar orquestrador, skills e Mongo/Docker" id="id-0ccbe4c77aee45dfab39189be76e2423">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Manter regras de status e vocabulário" id="id-6ac4484b4899456c8b63705211bca7c6">
        <documentation>Operação: keep.</documentation>
        <property key="operacao" value="keep" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar app Python offline com SQLite" id="id-dcd12405fb904fde8ce51aa55c6da3e9">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar calendário de feriados e emendas" id="id-c86de9762c6b476b925e15b5f5b8c912">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar fechamento do mês (pendências + folha)" id="id-bf42a34898294df7bea9f0d663e769f1">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar backup e restauração" id="id-eb358db0ff17483f927b327537cda6b3">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar anotações no WhatsApp" id="id-b842c034e15a4214964faa6d26739103">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Trocar a pesquisa de feriados por sugestão do app" id="id-c695f144ea6047ba86d49af7efccbd83">
        <documentation>Operação: eliminate + create.</documentation>
        <property key="operacao" value="eliminate + create" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP1 Limpar o repositório" id="id-9d58f6e1288949f8b9c25982b39cad61">
        <documentation>Remover Django, React, Flutter, orquestrador, skills, Mongo/Docker. Escrever o ADR-002.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP2 Domínio + contrato em Python" id="id-bc01961c980747ecbcf0755ee3e2da4b">
        <documentation>Status, validação, ordem, horas e extra; vetores golden em pytest.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP3 Repositório SQLite" id="id-aa08f461427443c49012e8917bd48d82">
        <documentation>Schema, migrações e upsert por data.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP4 Calendário" id="id-f00c5baed3ce450ba7f66724913edcc3">
        <documentation>lib holidays BR/SP, regra de emenda, datas de Cubatão.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP5 Telas Flet" id="id-b5b82311b24a4dadb22f05067c042a54">
        <documentation>Hoje (bater ponto), Mês, Folha, Ajustes.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP6 Exportação e backup" id="id-7670afbc7a834a899636eb89f4daa8c1">
        <documentation>Folha em texto/CSV, backup/restauração JSON.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP7 APK e CI" id="id-7a04cefb62c14565a235756a09c3adec">
        <documentation>flet build apk, teste de não-rede, workflow único.</documentation>
        <property key="status" value="configurado em 2026-11-05; falta o 1º build no CI" />
      </element>
      <element xsi:type="archimate:Deliverable" name="Repositório limpo + ADR-002" id="id-2ed391b983dd475394a26d5dee9768ae">
        <documentation>README, CLAUDE.md e docs atualizados.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="Pacote folha_ponto testado" id="id-c30ece57f59845db856e74dd42c63308">
        <documentation>Domínio, calendário e SQLite com pytest verde.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="App Flet funcional no PC" id="id-821b9efaa48347679c19bdd1cadf24dc">
        <documentation>Todos os casos de uso navegáveis.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="APK offline + CI" id="id-95d159d5be224fe6aa5388e8ea0860ea">
        <documentation>Instalável no celular.</documentation>
      </element>
    </folder>
  </folder>
