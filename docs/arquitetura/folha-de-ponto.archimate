<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Folha de Ponto Pessoal v2 (app offline)" id="id-de730dc40bfa4290b991d032548f3719" version="5.0.0">
  <folder name="Strategy" id="id-032d0404949e4ff9bcb09c26fb76165f" type="strategy">
    <folder name="A. Vision" id="id-8d37618550f24dc5ade9968cf2b1c69b">
      <element xsi:type="archimate:CourseOfAction" name="Reescrever como app Python offline no celular" id="id-5c763446271f41bca94d67aa7cd6ab46">
        <documentation>Uma pilha só (Python + uv + SQLite + Flet), rodando no aparelho do Trabalhador.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Registro de jornada" id="id-061161814cbb404bb8804ba6dcd0d81c">
        <documentation>Anotar marcações e classificar o dia.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Calendário de feriados e emendas" id="id-cbe8afa66f20420d94330aae7396ddab">
        <documentation>Feriados oficiais (lib pronta) + emendas e datas de Cubatão (sob medida).</documentation>
        <property key="subdominio DDD" value="Generic (lib holidays) + Supporting (emendas, municipais)" />
      </element>
      <element xsi:type="archimate:Capability" name="Fechamento da folha do mês" id="id-22e65e1f576f40f6b2100bb48b5f3c60">
        <documentation>Conferir pendências e copiar a folha.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Proteção dos dados" id="id-f3f66b4b789242178737ac5a6eebf67c">
        <documentation>Backup e restauração.</documentation>
        <property key="subdominio DDD" value="Supporting" />
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-e92aa65037fb4ba09e19fc5174e12212" type="business">
    <folder name="B. Business" id="id-a3c7e2468c3b4db9881b46654fe551f4">
      <element xsi:type="archimate:BusinessActor" name="Trabalhador" id="id-4c32b6bf6547410ea58577b31cef47ad">
        <documentation>Aprendiz que registra o próprio ponto. Único usuário do app.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Empresa" id="id-35e2865829794abd9146b2313b44b167">
        <documentation>Empregadora. Recebe a folha de ponto assinada.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Responsável pelo ponto" id="id-657c401c484a4722834d6f344db19dd1">
        <documentation>Anota, confere e preenche a própria folha.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Recebedor da folha" id="id-6a8330f322b0453dafee3d5cecab9ae2">
        <documentation>Recebe e arquiva a folha do mês.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Chegada, almoço ou saída" id="id-d8611fb3eb0f43b4b6edd5ee1d3a0979">
        <documentation>Cada um dos momentos que geram uma marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Fim do mês" id="id-9570f56d60a644e5ad6f61e92705b0b7">
        <documentation>Hora de preencher e entregar a folha oficial.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Folha de ponto oficial (papel)" id="id-bf52cc4fffd34f52b26638b5865eb820">
        <documentation>Uma linha por dia (01–31) com Manhã, Tarde e Extra (entrada/saída) e assinatura. Jornada 07:45–12:00 e 13:00–14:45.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Entregar a folha assinada" id="id-ee145d47615b493a98a71cf27789e24e">
        <documentation>Igual na baseline e no target (keep).</documentation>
      </element>
    </folder>
    <folder name="B. 2 Baseline" id="id-cd59995bf3d248afbb5f87a2a8631cea">
      <element xsi:type="archimate:BusinessObject" name="Mensagens com horários (WhatsApp)" id="id-1a08370eaeca4b26b680f107e81a4b8b">
        <documentation>Anotações soltas, sem estrutura.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Calendário de cabeça / internet" id="id-9a48b51c3b524fd2844146bbaac3a9a7">
        <documentation>Onde se descobre, no fim do mês, o que foi feriado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B1 Anotar horário no WhatsApp" id="id-b9e6941482864a3989ff030a0eff3bcf">
        <documentation>Mensagem para si mesmo a cada marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B2 Rolar as conversas do mês" id="id-f0455bbd28a442729bfe08e16d4cf73c">
        <documentation>Garimpar as mensagens, dia por dia.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B3 Descobrir feriados e emendas" id="id-1383af35c195416590a19afcbf93fdfb">
        <documentation>Lembrar ou pesquisar quais dias não eram úteis.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B4 Preencher a folha à mão" id="id-5ac4f158b7414532bf4c3429b0e14bb0">
        <documentation>Copiar o que foi garimpado para o papel.</documentation>
      </element>
    </folder>
    <folder name="B. 3 Target" id="id-4f1a31885c6f40bda5c31ae78ee9b68b">
      <element xsi:type="archimate:BusinessObject" name="Registro do dia" id="id-03c6613228e94d3a87b4cb47d2be80f7">
        <documentation>Data, tipo do dia, marcações Manhã/Tarde/Extra, observação e status (completo, incompleto, não trabalhado).</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T1 Bater o ponto no app" id="id-7c0b5df75d73473490e45b0c8c684b85">
        <documentation>Um toque grava a hora na próxima marcação vazia.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T2 Confirmar feriados e emendas sugeridos" id="id-9260121ff5b34bad8a0941dcec6f393f">
        <documentation>O app sugere; o Trabalhador confirma. Emenda confirmada = folga.</documentation>
        <property key="caso de uso" value="UC03, UC10" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T3 Resolver as pendências do mês" id="id-e5da0bc8cb6f4ff9ae145cf71a6f1341">
        <documentation>Completar os dias úteis sem lançamento ou incompletos.</documentation>
        <property key="caso de uso" value="UC05, UC07" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T4 Copiar a folha pela tela Folha" id="id-316a6f871b044948b5ad46556120ccbf">
        <documentation>Uma linha por dia, na ordem do papel. Marca cada linha copiada.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T6 Guardar o backup do mês" id="id-d308b062155147d090576f785cd2c62d">
        <documentation>Gerar o arquivo e guardá-lo fora do celular.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
    </folder>
  </folder>
  <folder name="Application" id="id-549db428a5c54514b506c89ae6e28dc2" type="application">
    <folder name="C. 2 Baseline" id="id-26bbb1a6cb304700ada9925707568218">
      <element xsi:type="archimate:ApplicationComponent" name="API Django + DRF" id="id-4080f43b93e042969a344761099f8c24">
        <documentation>src/backend: views → serializers → services → repositories, X-Api-Key.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Web React/Vite" id="id-63e4367127774b0da821bc9bfae8b21b">
        <documentation>src/web: abas Hoje/Mês, calendário, tela de chave de API.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="App Flutter (sqflite)" id="id-36833ce360af4c57a830a1ef4894933c">
        <documentation>src/mobile: offline, regras portadas para Dart, adapter HTTP opcional.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Orquestrador multi-CLI" id="id-061ffc58148346ceba246205227c7808">
        <documentation>orchestrator.sh (2 cópias): Claude Code builder + Antigravity auditor, agents/, skills/.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Gerador de contratos (Py/TS/Dart)" id="id-db9c2715c0ca46418b2249b34b5ad4a8">
        <documentation>contracts/generate.py escreve 3 alvos a partir de time_record.json.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="db.sqlite3 do servidor" id="id-567aefdda9da44b08fc7b5c6c1207391">
        <documentation>Banco do Django, no celular-servidor.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="folha_de_ponto.db do Flutter" id="id-d4cf6b712f014b79865ccd533bd278c2">
        <documentation>Banco independente do app Flutter, sem sync.</documentation>
      </element>
    </folder>
    <folder name="C. 3 Target" id="id-a217185fbc90405094a269bf1bf7d687">
      <element xsi:type="archimate:ApplicationComponent" name="App Folha de Ponto (pacote folha_ponto)" id="id-011aae0e6c354827ad07882b0002e336">
        <documentation>Um único pacote Python. Roda no celular (APK Flet) e no PC (uv run).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Interface (Flet)" id="id-11fe0a7f91b041a3bfe5378e4b8839d7">
        <documentation>Telas finas: só chamam os serviços do domínio.</documentation>
        <property key="modulo" value="folha_ponto/ui/" />
        <property key="subdominio DDD" value="Generic (framework Flet)" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Domínio: regras do dia" id="id-879c5d56a3d94dc39d6759bebdb13a29">
        <documentation>Status, validação HH:MM e ordem das marcações, horas e saldo, pendências e folha do mês. Python puro.</documentation>
        <property key="modulo" value="folha_ponto/dominio/" />
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Calendário: feriados e emendas" id="id-a33d1804aa484c75b2b4c07c571db67a">
        <documentation>Gera o ano pela lib holidays (BR/UF, public + optional; UF desconhecida cai nos nacionais), aplica a regra de emenda (RN05, inclusive na virada do ano) sobre feriados, facultativos e datas manuais, e grava pelo Repositório. Confirma/descarta emendas (UC03) e cadastra datas manuais (UC10).</documentation>
        <property key="modulo" value="folha_ponto/calendario/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Repositório SQLite" id="id-8889b8b9969641c78903a6191beac361">
        <documentation>sqlite3 da stdlib, migrações por PRAGMA user_version, transações atômicas e trava para as threads do Flet. Único que fala SQL. Implementa a porta Calendario.</documentation>
        <property key="modulo" value="folha_ponto/dados/" />
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Exportação e backup" id="id-80a672d1d40b47d7a192058c55019966">
        <documentation>Folha em texto/CSV; backup e restauração em JSON.</documentation>
        <property key="modulo" value="folha_ponto/exportacao/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Biblioteca holidays (Calendário oficial do Brasil)" id="id-49bf13a8a56b42f3ab5199e48362b688">
        <documentation>Dependência open source, offline. Ator secundário do UC06.</documentation>
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Telas Hoje · Mês · Folha · Ajustes" id="id-6ab4d82d125a4dcbb82e5d51ab042aca">
        <documentation>O que o Trabalhador toca.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Registrar marcação" id="id-7796e0c85c2f435382f0a2776d5a3b4a">
        <documentation>Serviço que atende UC01, UC02, UC04.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Consultar mês" id="id-40c2538078c64fa48da644e8cd947f40">
        <documentation>Serviço que atende UC05.</documentation>
        <property key="caso de uso" value="UC05" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Sugerir feriados e emendas" id="id-97fa6f5dc8f6408b83025c5fbe8716c0">
        <documentation>Serviço que atende UC03, UC06, UC10.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Listar pendências do mês" id="id-c5eafcca0da24d32882171960fe33e55">
        <documentation>Serviço que atende UC07.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Gerar folha para cópia" id="id-7d1746156e7348c7977158603ce7ccc0">
        <documentation>Serviço que atende UC08.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Backup e restauração" id="id-ac68bfff84044bebb68054b5353243cd">
        <documentation>Serviço que atende UC09.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Configurar preferências" id="id-cb82e8ac80ef4d56b3d67f397db6b8aa">
        <documentation>Serviço que atende UC11.</documentation>
        <property key="caso de uso" value="UC11" />
      </element>
    </folder>
    <folder name="C. Dados" id="id-dfbb0ee1e25646569bb92512631868ba">
      <element xsi:type="archimate:DataObject" name="Lançamento do dia (tabela lancamentos)" id="id-39f1d3a0e3c545328fdf139e46a61b93">
        <documentation>data (única), tipo, entrada, saida_almoco, volta_almoco, saida, entrada_extra, saida_extra, observacao, criado_em, atualizado_em.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Data especial (tabela datas_especiais)" id="id-8810c7a71ffb475da05a7dc5b10ffb2d">
        <documentation>data, nome, natureza (feriado, facultativo, emenda, emenda_sugerida), origem (nacional, estadual, facultativo, regra_emenda, manual), recorrente, oculta, fonte (versão da lib).</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Preferências (tabela preferencias)" id="id-9790a4b3ac1248f0a1b33ac19999bd62">
        <documentation>UF, município, jornada padrão, facultativo conta como folga (padrão: sim), tema.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Vocabulário do domínio (vocabulario.py)" id="id-42013537cdea440aa2e61ce8e51a5801">
        <documentation>Enums TipoDia, Status e Marcacao: fonte única dos termos. Sucede o contracts/time_record.json da v1.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Arquivo de backup (JSON)" id="id-edf2602b0cf54d18a0bfb9f1961853f0">
        <documentation>Versionado; lançamentos, datas manuais, emendas confirmadas, preferências.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Folha do mês (texto/CSV)" id="id-efd9783fe94a43678ae25e2fc075aeff">
        <documentation>Mesma ordem de colunas do papel.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-ce6a2c0478cd4ab5a545815e789361f6" type="technology">
    <folder name="D. 2 Baseline" id="id-918841cd4217452abb0e65bd0b3c252e">
      <element xsi:type="archimate:Device" name="Celular velho (Termux + sshd)" id="id-d7fb57630f574b19a0c3120920b4eaed">
        <documentation>Servidor Django na Wi-Fi de casa, porta 8000. Sai do projeto.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC na rede de casa (WSL2)" id="id-571988389df24d0d878cd7cbd58fa712">
        <documentation>Build do frontend e deploy por SSH (scripts/deploy-celular.sh).</documentation>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="Wi-Fi de casa" id="id-1047eb7985a1401394a13c71ec011ab9">
        <documentation>Única rede onde o app atual funciona.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Docker + MongoDB + Caddy" id="id-3d0b06c261a541eebbf436d5e01086c0">
        <documentation>Restos do plano original. Nunca usados pelo código atual.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (Django, Flutter, contratos)" id="id-ef3d2f721a0241458d16639d1092588d">
        <documentation>3 workflows.</documentation>
      </element>
    </folder>
    <folder name="D. 3 Target" id="id-adbcb9102d7543d888b949e4f66552e8">
      <element xsi:type="archimate:Device" name="Celular Android do Trabalhador" id="id-c47f2053903043e08138c3436c353836">
        <documentation>O mesmo aparelho que vai no bolso. Nada roda fora dele.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Android" id="id-36fc49e0c15341e3b1774587741fe3ad">
        <documentation>Sem permissão INTERNET no manifest.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Python embarcado (Flet)" id="id-6f8da403181049aabcd535a5c0bc4928">
        <documentation>Runtime Python empacotado no APK pelo flet build.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="SQLite (sqlite3 da stdlib)" id="id-cfda938fa9b3422bb440b53d08f36ead">
        <documentation>Banco embutido, arquivo único.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Armazenamento privado do app" id="id-2afb60f4e4ae42e68caef4a392ac4654">
        <documentation>Diretório de dados do app, apagado só na desinstalação.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Compartilhamento do Android" id="id-6b56e80c0f284e8bbffe32c7fb5ff0a4">
        <documentation>Menu Compartilhar: salvar, WhatsApp, e-mail, Drive.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha-de-ponto.apk" id="id-c815331df3194ed9b9c208b5471ee032">
        <documentation>Gerado por `uv run flet build apk`.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha_de_ponto.db" id="id-b272a1ebcbc04f90a00396a6c52b85ac">
        <documentation>Arquivo SQLite com lancamentos, datas_especiais e preferencias. Pasta: FLET_APP_STORAGE_DATA.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="backup-AAAA-MM-DD.json" id="id-13765726426c40ef9b7a39f14aac7c99">
        <documentation>Arquivo de backup que o usuário guarda fora do celular.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC de desenvolvimento" id="id-583b9a4cfe56422a9bde16764bbfc206">
        <documentation>Onde se programa, testa e gera o APK.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="uv + Python 3.12" id="id-6df9903eb9b9443da28de47d52ca3c99">
        <documentation>uv sync, uv run, uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="pytest" id="id-a0aa5c4e09774f98b895e176dd3c9a95">
        <documentation>Testes do domínio, do calendário e do SQLite, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (pytest + build APK)" id="id-c6a588287b00462e8985bbf7b6426fb2">
        <documentation>Um workflow só.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="Pacote folha_ponto (pyproject.toml + uv.lock)" id="id-6f372d94e7574f46b2366bbde0705353">
        <documentation>Código-fonte versionado no git.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyProcess" name="Gerar o APK" id="id-6852caef7f414c37b5f59f783da29c59">
        <documentation>flet build apk a partir do pacote.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Motivation" id="id-463ceb9d815140019a1f3d2d22446ab0" type="motivation">
    <folder name="0. Preliminar" id="id-48fab53968cd4cdbb1384fa3e51ad5b4">
      <element xsi:type="archimate:Principle" name="Offline primeiro (local-first)" id="id-6720b6211fe3442cbcb43cfdab61a919">
        <documentation>O app funciona sem rede, em qualquer lugar. Nenhum caminho de uso depende de servidor ou internet.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Simplicidade antes de generalidade" id="id-68265ea7c7164085a5e5fe9e195c2f9f">
        <documentation>Uma única pilha e um único banco. Só se adiciona peça quando um caso de uso precisa dela.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Uma linguagem: Python com uv" id="id-37c5896912554be0b866709a19173b0e">
        <documentation>Regras, persistência, calendário e interface em Python. Dependências fixadas em pyproject.toml + uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Regras testáveis sem interface" id="id-85efe9ee69564609ad7bba6ac79cd90a">
        <documentation>Domínio e calendário em Python puro, testados com pytest no PC, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Dados do usuário no aparelho e sob controle dele" id="id-c287a50d773348b4bfa6854f7e8185d5">
        <documentation>Os lançamentos ficam no SQLite do app. O backup é um arquivo que o próprio usuário guarda.</documentation>
      </element>
    </folder>
    <folder name="A. Vision" id="id-dc36cc70a86d480da294ad6746bf96c9">
      <element xsi:type="archimate:Stakeholder" name="Trabalhador (aprendiz)" id="id-f565de9540134008bb450b1d74692c47">
        <documentation>Dono da folha de ponto. Anota os horários todo dia e preenche a folha oficial no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Empresa (RH / supervisor)" id="id-a940a3d27dcc41d1a9c80c43dd48ac19">
        <documentation>Recebe a folha de ponto preenchida e assinada no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Horários espalhados no WhatsApp" id="id-e845c513e9a947b3851ffdf7c088ccc9">
        <documentation>Entrada, almoço, volta e saída ficam em mensagens soltas ao longo de semanas.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Rede da empresa bloqueia APIs externas" id="id-016ad9f86f2a43bca6d3a5a6ffc24485">
        <documentation>No trabalho não dá para depender de servidor em casa nem de API na internet.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Feriados e emendas esquecidos" id="id-ca4a4560b474480db5a8cd5904cbb601">
        <documentation>No fim do mês é preciso lembrar quais dias foram feriado, ponto facultativo ou emenda.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Complexidade acidental do repositório" id="id-df9695d2a718434b9054448c19a42a23">
        <documentation>Django, React, Flutter, orquestrador multi-CLI e restos de MongoDB convivem para um app de uma pessoa.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Folha oficial correta e no prazo" id="id-5a04f5312b4c4b6daedd934e67f52fa9">
        <documentation>A empresa precisa da folha de papel preenchida, sem lacunas, no fim de cada mês.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Fim do mês exige garimpar conversas" id="id-390b6311833540d8b50c9188827f1d6a">
        <documentation>Juntar os horários vira um trabalho à parte, repetitivo e sujeito a erro (README).</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="App atual depende de servidor na rede de casa" id="id-5a7833d60cfb4a59bada63dc1da6e7e8">
        <documentation>O web-app roda num celular velho com Termux; fora de casa, não abre.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Regras duplicadas em Python e Dart" id="id-8950256b65b4498d88920472e6ede027">
        <documentation>calculate_status existe em services.py e em status.dart, mantidos juntos por vetores golden.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Sem backup dos dados" id="id-c80ac1db71d94f2e8f606bad125e5741">
        <documentation>Perder ou trocar o celular perde o histórico (consequência registrada no ADR-001).</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Preencher a folha do mês sem garimpo" id="id-6aa771ade30946bd962b3b197d1dba68">
        <documentation>Ter tudo do mês num só lugar, na ordem da folha de papel.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Registrar o ponto na hora, em segundos" id="id-b33e9fc6f91645d298de2d6438ce22b0">
        <documentation>A anotação acontece no momento do evento, com um toque.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Funcionar em qualquer rede, sem internet" id="id-8f3a2bdb9fd64266a100fa4e4bb04931">
        <documentation>Inclusive dentro da rede da empresa.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Manter o projeto simples de evoluir" id="id-3783e62390e347b58dbaee849ce7940e">
        <documentation>Uma pilha, poucos arquivos, testes rápidos. Fácil de estudar e de mudar.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Não perder o histórico" id="id-0b0bad468e2d4f33b30c12bb989531df">
        <documentation>O usuário consegue guardar e restaurar os próprios dados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Folha copiada numa só sessão" id="id-445e305f8c554cffa7ffc722e0c37c49">
        <documentation>Sem abrir o WhatsApp nem consultar outro calendário.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Nenhum dia útil esquecido" id="id-24f0e461f47341cab78ca017f54c95c4">
        <documentation>O app aponta todo dia útil sem lançamento ou incompleto.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Ponto batido no momento em que acontece" id="id-8ccf878ecd3849e39d5d680bb1a0ec97">
        <documentation>Em até 2 toques a partir do ícone do app.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Bater o ponto em até 2 toques" id="id-8b848ccfac1047aea598df3d9edfde73">
        <documentation>UC01, RNF04.</documentation>
        <property key="caso de uso" value="UC01" />
      </element>
      <element xsi:type="archimate:Requirement" name="Sugerir feriados e emendas automaticamente" id="id-20966adbe9644a5dbd0e023ca81841b6">
        <documentation>Nacionais e de SP pela lib holidays; Cubatão e emendas da empresa cadastrados. Emenda = folga.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:Requirement" name="Listar as pendências do mês" id="id-4c71ce3483454036977e63d5c8844f23">
        <documentation>Dia útil sem lançamento, lançamento incompleto, emenda a confirmar.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:Requirement" name="Mostrar o mês na ordem da folha de papel" id="id-da83537e9bfa4222811c0b24b8700dc7">
        <documentation>DIA · Manhã E/S · Tarde E/S · Extra E/S · observação, dias 01 a 31 corridos.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar hora extra" id="id-4789d01d85404dc2870cba3975ef7278">
        <documentation>Par de marcações Extra (entrada/saída), como na folha oficial.</documentation>
        <property key="caso de uso" value="UC01, UC02" />
      </element>
      <element xsi:type="archimate:Requirement" name="Backup e restauração por arquivo" id="id-669298fe4234400eaaeecf1095afbc66">
        <documentation>JSON versionado, mesclar ou substituir.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:Constraint" name="APK sem permissão de internet" id="id-4e835bd6ed4242c182cfbd4cda83cd8a">
        <documentation>RNF01. Um teste reprova qualquer import de rede.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Python ≥ 3.12 gerenciado com uv" id="id-c0f5e61b7ff641838db9cd29fdb7ff36">
        <documentation>RNF02. Decisão do usuário.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Folha oficial em papel, preenchida à mão" id="id-fc64da23ad284b42becde86aea565e71">
        <documentation>O app não substitui a folha: ele organiza o que vai ser copiado para ela.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-0a45587d165a4ce79d081a64173ed549" type="implementation_migration">
    <folder name="E-F. Roadmap" id="id-3cbca2d134594eb7bf384fe567ef1ded">
      <element xsi:type="archimate:Plateau" name="Baseline (nov/2026)" id="id-aa8623a1db804186abd4e590f206618b">
        <documentation>Três pilhas, servidor no celular velho, rede de casa.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 1: núcleo Python testado" id="id-642246890df648deb0a0e4f5862ee9a5">
        <documentation>Domínio, calendário e SQLite com pytest; uma CLI mínima no PC já registra e mostra a folha.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 2: app Flet no PC" id="id-a13c29e6edc2448d9f3fc4802cdc7897">
        <documentation>Mesmas telas do celular rodando com `uv run`.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Target: APK offline no celular" id="id-9b9f5a6d16f84394ba6099fe674b0a27">
        <documentation>App instalado, sem rede, com backup.</documentation>
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar servidor, API e API key" id="id-b49a761237de4ebebea1bc7ef905924d">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar React, Flutter e regras em Dart" id="id-e02836aa3430409abab70cb6fc5b3456">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar orquestrador, skills e Mongo/Docker" id="id-22170f6ba6ef401582854ae7792fad8d">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Manter regras de status e vocabulário" id="id-a5d891a14baa424194c9c93f95cddbb1">
        <documentation>Operação: keep.</documentation>
        <property key="operacao" value="keep" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar app Python offline com SQLite" id="id-8337882af26d446f916fed280ad2071e">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar calendário de feriados e emendas" id="id-815385b0daa84843a371eae566cb80be">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar fechamento do mês (pendências + folha)" id="id-8c263ea2159a470ebffcdffc3afb54f0">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar backup e restauração" id="id-21f20997fea842f5845c66ac2e84aa44">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar anotações no WhatsApp" id="id-b08721c490c74a69b29d5a9241b31826">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Trocar a pesquisa de feriados por sugestão do app" id="id-44a98b8685fd48ea93f265333b1eeea9">
        <documentation>Operação: eliminate + create.</documentation>
        <property key="operacao" value="eliminate + create" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP1 Limpar o repositório" id="id-a7596f287eaf485cb9ff79fc3ba39feb">
        <documentation>Remover Django, React, Flutter, orquestrador, skills, Mongo/Docker. Escrever o ADR-002.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP2 Domínio + contrato em Python" id="id-04a64bfecbc64855944714074db47127">
        <documentation>Status, validação, ordem, horas e extra; vetores golden em pytest.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP3 Repositório SQLite" id="id-eb2b23cd167c47bd90e50ac76c4a0526">
        <documentation>Schema, migrações e upsert por data.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP4 Calendário" id="id-c03560e9a32f4410abb907b3691a0f1b">
        <documentation>lib holidays BR/SP, regra de emenda, datas de Cubatão.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP5 Telas Flet" id="id-ade388569de54fa097c1089b9964ef91">
        <documentation>Hoje (bater ponto), Mês, Folha, Ajustes.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP6 Exportação e backup" id="id-5c91007f451f41d39fd65637f72953d0">
        <documentation>Folha em texto/CSV, backup/restauração JSON.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP7 APK e CI" id="id-320121fbf8674c319350a1b4769cba83">
        <documentation>flet build apk, teste de não-rede, workflow único.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:Deliverable" name="Repositório limpo + ADR-002" id="id-a3567dd3dd9e4fdcbecf6e75b7d3b5db">
        <documentation>README, CLAUDE.md e docs atualizados.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="Pacote folha_ponto testado" id="id-5bce2ea7b8334b378108e762bcb56f26">
        <documentation>Domínio, calendário e SQLite com pytest verde.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="App Flet funcional no PC" id="id-4ec1ad1d85dd454a8c13f2ed7986e2dd">
        <documentation>Todos os casos de uso navegáveis.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="APK offline + CI" id="id-baccfbe7f2a14c1b9de27d58fd9ce8c9">
        <documentation>Instalável no celular.</documentation>
      </element>
    </folder>
  </folder>
