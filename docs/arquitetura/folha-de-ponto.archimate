<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Folha de Ponto Pessoal v2 (app offline)" id="id-b1e9d5ac0afe44e1bd26d6081b746937" version="5.0.0">
  <folder name="Strategy" id="id-3ff79b3a2ed44ca187c592105a7b6335" type="strategy">
    <folder name="A. Vision" id="id-a190a7c04e6b4e1480dce4e83d6772cc">
      <element xsi:type="archimate:CourseOfAction" name="Reescrever como app Python offline no celular" id="id-8dc75b38efbc4afda526200ec816306c">
        <documentation>Uma pilha só (Python + uv + SQLite + Flet), rodando no aparelho do Trabalhador.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Registro de jornada" id="id-9b10845c625644359984184930b90339">
        <documentation>Anotar marcações e classificar o dia.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Calendário de feriados e emendas" id="id-45ab0c41967a45ac8e0e00c83b8e791c">
        <documentation>Feriados oficiais (lib pronta) + emendas e datas de Cubatão (sob medida).</documentation>
        <property key="subdominio DDD" value="Generic (lib holidays) + Supporting (emendas, municipais)" />
      </element>
      <element xsi:type="archimate:Capability" name="Fechamento da folha do mês" id="id-d3b64e39816c482b8eff1cddf3f79f31">
        <documentation>Conferir pendências e copiar a folha.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Proteção dos dados" id="id-0d62ff60daba451fb3bd2d3acae86cc8">
        <documentation>Backup e restauração.</documentation>
        <property key="subdominio DDD" value="Supporting" />
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-c8a8cace76564d48be8382fd3997a57c" type="business">
    <folder name="B. Business" id="id-efca6747b0c14e2c876bf628b7ff56e8">
      <element xsi:type="archimate:BusinessActor" name="Trabalhador" id="id-f1049f1afd0a41e38fc37b6bc93480fe">
        <documentation>Aprendiz que registra o próprio ponto. Único usuário do app.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Empresa" id="id-439424e3d710429b9c1c99b11b87e188">
        <documentation>Empregadora. Recebe a folha de ponto assinada.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Responsável pelo ponto" id="id-f85aa362a62045c7be6a4e1ba77250fc">
        <documentation>Anota, confere e preenche a própria folha.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Recebedor da folha" id="id-0b0b0049fc65447cb5ca150c73b7094a">
        <documentation>Recebe e arquiva a folha do mês.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Chegada, almoço ou saída" id="id-a063a9de92ec4f0f93b318ad198c5ccb">
        <documentation>Cada um dos momentos que geram uma marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Fim do mês" id="id-56f0e5a867dd463ea3774bb4a14e5f9e">
        <documentation>Hora de preencher e entregar a folha oficial.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Folha de ponto oficial (papel)" id="id-3f688e166d8e4c6296273eb135c6b1e1">
        <documentation>Uma linha por dia (01–31) com Manhã, Tarde e Extra (entrada/saída) e assinatura. Jornada 07:45–12:00 e 13:00–14:45.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Entregar a folha assinada" id="id-de86adf3b52d4511927d140468667202">
        <documentation>Igual na baseline e no target (keep).</documentation>
      </element>
    </folder>
    <folder name="B. 2 Baseline" id="id-c4ca8f8abd0849049ae847555cc4dd43">
      <element xsi:type="archimate:BusinessObject" name="Mensagens com horários (WhatsApp)" id="id-2ed1e75b33ef4ec08bbba69da1ebd8e6">
        <documentation>Anotações soltas, sem estrutura.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Calendário de cabeça / internet" id="id-2d83ed7b202842cbabefbaa1cbc8012a">
        <documentation>Onde se descobre, no fim do mês, o que foi feriado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B1 Anotar horário no WhatsApp" id="id-4d66d0880fcd487a894ef7889dbf5514">
        <documentation>Mensagem para si mesmo a cada marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B2 Rolar as conversas do mês" id="id-7663a661255145ee91b54b3c8ab11329">
        <documentation>Garimpar as mensagens, dia por dia.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B3 Descobrir feriados e emendas" id="id-3ba309d33d5d4788822a2d0940312deb">
        <documentation>Lembrar ou pesquisar quais dias não eram úteis.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B4 Preencher a folha à mão" id="id-475644893f19487b8aa549c22657373e">
        <documentation>Copiar o que foi garimpado para o papel.</documentation>
      </element>
    </folder>
    <folder name="B. 3 Target" id="id-a2570f6262064e41ac080f105fc8179a">
      <element xsi:type="archimate:BusinessObject" name="Registro do dia" id="id-626dd08404f54d6fbd876face6460262">
        <documentation>Data, tipo do dia, marcações Manhã/Tarde/Extra, observação e status (completo, incompleto, não trabalhado).</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T1 Bater o ponto no app" id="id-e721ee87a3ac493a866ee95998bdbdca">
        <documentation>Um toque grava a hora na próxima marcação vazia.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T2 Confirmar feriados e emendas sugeridos" id="id-aef1947ed6b94d63ac23d4afd15f0571">
        <documentation>O app sugere; o Trabalhador confirma. Emenda confirmada = folga.</documentation>
        <property key="caso de uso" value="UC03, UC10" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T3 Resolver as pendências do mês" id="id-5e80fc8fdb354224b5ff1363cb42ee60">
        <documentation>Completar os dias úteis sem lançamento ou incompletos.</documentation>
        <property key="caso de uso" value="UC05, UC07" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T4 Copiar a folha pela tela Folha" id="id-3860367be6ac420fae59e18f1c14625d">
        <documentation>Uma linha por dia, na ordem do papel. Marca cada linha copiada.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T6 Guardar o backup do mês" id="id-44da925dde974fa6aa8a7c5854806040">
        <documentation>Gerar o arquivo e guardá-lo fora do celular.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
    </folder>
  </folder>
  <folder name="Application" id="id-7ed71e013ded4f0aae155943cc727635" type="application">
    <folder name="C. 2 Baseline" id="id-70a54c92b7fc49ce82833d88818223d7">
      <element xsi:type="archimate:ApplicationComponent" name="API Django + DRF" id="id-3d7edb8d760d4be3979b9f214fb222b2">
        <documentation>src/backend: views → serializers → services → repositories, X-Api-Key.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Web React/Vite" id="id-d58d38eca948485b97cd8e5a55b7eac8">
        <documentation>src/web: abas Hoje/Mês, calendário, tela de chave de API.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="App Flutter (sqflite)" id="id-4c60e0568cad433a9c8d4c40c933f1cd">
        <documentation>src/mobile: offline, regras portadas para Dart, adapter HTTP opcional.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Orquestrador multi-CLI" id="id-b7c0ed3bcb99453194afa246b6d41b2d">
        <documentation>orchestrator.sh (2 cópias): Claude Code builder + Antigravity auditor, agents/, skills/.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Gerador de contratos (Py/TS/Dart)" id="id-0de456a471244f8e85a853bc1c5c37f0">
        <documentation>contracts/generate.py escreve 3 alvos a partir de time_record.json.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="db.sqlite3 do servidor" id="id-497d417af8874360916bb5293e70b39a">
        <documentation>Banco do Django, no celular-servidor.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="folha_de_ponto.db do Flutter" id="id-d127508634f241afbec36f4f8195660f">
        <documentation>Banco independente do app Flutter, sem sync.</documentation>
      </element>
    </folder>
    <folder name="C. 3 Target" id="id-ccef9334206c45a6a1567847731e89e4">
      <element xsi:type="archimate:ApplicationComponent" name="App Folha de Ponto (pacote folha_ponto)" id="id-354c486938c44a089f8809f8b28c0286">
        <documentation>Um único pacote Python. Roda no celular (APK Flet) e no PC (uv run).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Interface (Flet)" id="id-58acd9defcbf4e198d55d37325458a06">
        <documentation>Telas finas: só chamam os serviços do domínio.</documentation>
        <property key="modulo" value="folha_ponto/ui/" />
        <property key="subdominio DDD" value="Generic (framework Flet)" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Domínio: regras do dia" id="id-a913a481aae24ebb823bc36d4f0c8c3c">
        <documentation>Status, validação HH:MM e ordem das marcações, horas e saldo, pendências e folha do mês. Python puro.</documentation>
        <property key="modulo" value="folha_ponto/dominio/" />
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Calendário: feriados e emendas" id="id-71d80323c6974d5bb745280a89999207">
        <documentation>Gera o ano pela lib holidays (BR/SP, public + optional), aplica a regra de emenda e mescla as datas manuais.</documentation>
        <property key="modulo" value="folha_ponto/calendario/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Repositório SQLite" id="id-9afeef1e17a84d1d828f2de47c8fe430">
        <documentation>sqlite3 da stdlib, migrações por PRAGMA user_version, transações atômicas e trava para as threads do Flet. Único que fala SQL. Implementa a porta Calendario.</documentation>
        <property key="modulo" value="folha_ponto/dados/" />
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Exportação e backup" id="id-09c6b34c42754c3db4d98ef40e7677ad">
        <documentation>Folha em texto/CSV; backup e restauração em JSON.</documentation>
        <property key="modulo" value="folha_ponto/exportacao/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Biblioteca holidays (Calendário oficial do Brasil)" id="id-75fda1ebfee14dd2a1048486d7c73fe3">
        <documentation>Dependência open source, offline. Ator secundário do UC06.</documentation>
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Telas Hoje · Mês · Folha · Ajustes" id="id-6f370b5f6a0b4a559136df0c4f44d476">
        <documentation>O que o Trabalhador toca.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Registrar marcação" id="id-c12509dad8894d7fb3501e2530774a10">
        <documentation>Serviço que atende UC01, UC02, UC04.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Consultar mês" id="id-8d41be2f31784e129edd344460324044">
        <documentation>Serviço que atende UC05.</documentation>
        <property key="caso de uso" value="UC05" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Sugerir feriados e emendas" id="id-de9d159c4f4b4b568f875c406cdbf49a">
        <documentation>Serviço que atende UC03, UC06, UC10.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Listar pendências do mês" id="id-9f201527916c4cc7b641f5bb9369cdfe">
        <documentation>Serviço que atende UC07.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Gerar folha para cópia" id="id-eb6a98b2278c4dfe91ccdce1f8e39ccb">
        <documentation>Serviço que atende UC08.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Backup e restauração" id="id-261639f298d44a6a9cf3c754c7c2e933">
        <documentation>Serviço que atende UC09.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Configurar preferências" id="id-c2da50cf2e18499285f33072f1178983">
        <documentation>Serviço que atende UC11.</documentation>
        <property key="caso de uso" value="UC11" />
      </element>
    </folder>
    <folder name="C. Dados" id="id-5a8379296a6b4cd08e74820f14edc417">
      <element xsi:type="archimate:DataObject" name="Lançamento do dia (tabela lancamentos)" id="id-56173f06b9784837b2cc41fea8594849">
        <documentation>data (única), tipo, entrada, saida_almoco, volta_almoco, saida, entrada_extra, saida_extra, observacao, criado_em, atualizado_em.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Data especial (tabela datas_especiais)" id="id-d24bcd4f62494a7c89d119b84068c8ab">
        <documentation>data, nome, natureza (feriado, facultativo, emenda, emenda_sugerida), origem (nacional, estadual, facultativo, regra_emenda, manual), recorrente, oculta, fonte (versão da lib).</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Preferências (tabela preferencias)" id="id-797883718a534b09a8428352e954cbfb">
        <documentation>UF, município, jornada padrão, facultativo conta como folga (padrão: sim), tema.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Vocabulário do domínio (vocabulario.py)" id="id-7f67ab9bb015443aad2d1124fcff70fa">
        <documentation>Enums TipoDia, Status e Marcacao: fonte única dos termos. Sucede o contracts/time_record.json da v1.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Arquivo de backup (JSON)" id="id-d54300ac1a604f528c0482734ef723e5">
        <documentation>Versionado; lançamentos, datas manuais, emendas confirmadas, preferências.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Folha do mês (texto/CSV)" id="id-43c6473b60cd4e89b8e60e6e09bea567">
        <documentation>Mesma ordem de colunas do papel.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-e344145d9edd42fea8e7242a6aae8c22" type="technology">
    <folder name="D. 2 Baseline" id="id-36a14c0b8c43441fa3b0c28b63e84095">
      <element xsi:type="archimate:Device" name="Celular velho (Termux + sshd)" id="id-12ec9235bdc8458fbd7d197d8d3431cf">
        <documentation>Servidor Django na Wi-Fi de casa, porta 8000. Sai do projeto.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC na rede de casa (WSL2)" id="id-29b3e36a58bb4b8f8a764e44834fbe54">
        <documentation>Build do frontend e deploy por SSH (scripts/deploy-celular.sh).</documentation>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="Wi-Fi de casa" id="id-04edb414fa2549128730b2b103c0eeaa">
        <documentation>Única rede onde o app atual funciona.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Docker + MongoDB + Caddy" id="id-094042b7f8914620b2d23ec83d75b358">
        <documentation>Restos do plano original. Nunca usados pelo código atual.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (Django, Flutter, contratos)" id="id-c5e904067bed4f97b353e4b5654a8659">
        <documentation>3 workflows.</documentation>
      </element>
    </folder>
    <folder name="D. 3 Target" id="id-473f0305996f4db1819e608c915d4646">
      <element xsi:type="archimate:Device" name="Celular Android do Trabalhador" id="id-cbfe071a27164083b229f26567e2c2c9">
        <documentation>O mesmo aparelho que vai no bolso. Nada roda fora dele.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Android" id="id-09c2af55b55b43d5a74e0160bb895d33">
        <documentation>Sem permissão INTERNET no manifest.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Python embarcado (Flet)" id="id-d6f95eb9f94249d488384b1d2ff3842a">
        <documentation>Runtime Python empacotado no APK pelo flet build.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="SQLite (sqlite3 da stdlib)" id="id-29b893a443f94263a6b2cf85ec772de5">
        <documentation>Banco embutido, arquivo único.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Armazenamento privado do app" id="id-e91d28f135b948adb0ac7e4811152570">
        <documentation>Diretório de dados do app, apagado só na desinstalação.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Compartilhamento do Android" id="id-0c03ffcd9f5e4548bacc63dd97413d77">
        <documentation>Menu Compartilhar: salvar, WhatsApp, e-mail, Drive.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha-de-ponto.apk" id="id-76d88ab5b84347f1a8394efed7a33d39">
        <documentation>Gerado por `uv run flet build apk`.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha_de_ponto.db" id="id-c3cbaf78195643f1b606aec054f8e623">
        <documentation>Arquivo SQLite com lancamentos, datas_especiais e preferencias. Pasta: FLET_APP_STORAGE_DATA.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="backup-AAAA-MM-DD.json" id="id-4f581d7c39214324a1a1789d98401ee9">
        <documentation>Arquivo de backup que o usuário guarda fora do celular.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC de desenvolvimento" id="id-9888b1b45424405fb1805763b055413e">
        <documentation>Onde se programa, testa e gera o APK.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="uv + Python 3.12" id="id-ca2fc81f964540d39a16a5e5549187f4">
        <documentation>uv sync, uv run, uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="pytest" id="id-b08b340b16894978b2abc90098b04335">
        <documentation>Testes do domínio, do calendário e do SQLite, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (pytest + build APK)" id="id-d5a649cbbba340609e67be0a5536647e">
        <documentation>Um workflow só.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="Pacote folha_ponto (pyproject.toml + uv.lock)" id="id-5c2fb8a56fdb4fa6903806181d7cce58">
        <documentation>Código-fonte versionado no git.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyProcess" name="Gerar o APK" id="id-77cf81c201334eb499e4ce7c98841ddf">
        <documentation>flet build apk a partir do pacote.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Motivation" id="id-b872cfe2d672441a8fe65d85c2ecc1b5" type="motivation">
    <folder name="0. Preliminar" id="id-c99fc4ce588f4a0d8856b17256cf2e65">
      <element xsi:type="archimate:Principle" name="Offline primeiro (local-first)" id="id-73d6bf4bf7884fbfb2928e31bae7e350">
        <documentation>O app funciona sem rede, em qualquer lugar. Nenhum caminho de uso depende de servidor ou internet.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Simplicidade antes de generalidade" id="id-3e173008ec224fa6ba56c946aa086215">
        <documentation>Uma única pilha e um único banco. Só se adiciona peça quando um caso de uso precisa dela.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Uma linguagem: Python com uv" id="id-2e3204832ec64b608ea5667d8b927353">
        <documentation>Regras, persistência, calendário e interface em Python. Dependências fixadas em pyproject.toml + uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Regras testáveis sem interface" id="id-7d6dee1d68c74460a1a6d5116285b9aa">
        <documentation>Domínio e calendário em Python puro, testados com pytest no PC, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Dados do usuário no aparelho e sob controle dele" id="id-a5d6b48d3b6545f9b5fbf581da440737">
        <documentation>Os lançamentos ficam no SQLite do app. O backup é um arquivo que o próprio usuário guarda.</documentation>
      </element>
    </folder>
    <folder name="A. Vision" id="id-5586a2a042f44ceaaa67f524fb4b3950">
      <element xsi:type="archimate:Stakeholder" name="Trabalhador (aprendiz)" id="id-b36ea0acd1224f0c81ca64bfc4d73d33">
        <documentation>Dono da folha de ponto. Anota os horários todo dia e preenche a folha oficial no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Empresa (RH / supervisor)" id="id-7a64016f6285410da7cd24dca6f07a52">
        <documentation>Recebe a folha de ponto preenchida e assinada no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Horários espalhados no WhatsApp" id="id-1c272dfba5044d2da9f87fe46a374398">
        <documentation>Entrada, almoço, volta e saída ficam em mensagens soltas ao longo de semanas.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Rede da empresa bloqueia APIs externas" id="id-3f3e299bed90444abb9db736bb229f24">
        <documentation>No trabalho não dá para depender de servidor em casa nem de API na internet.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Feriados e emendas esquecidos" id="id-6c4c9a9971dd44eebecc06ed01768dfe">
        <documentation>No fim do mês é preciso lembrar quais dias foram feriado, ponto facultativo ou emenda.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Complexidade acidental do repositório" id="id-f9cbd9b3c36e4d958231b4be48fe8cea">
        <documentation>Django, React, Flutter, orquestrador multi-CLI e restos de MongoDB convivem para um app de uma pessoa.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Folha oficial correta e no prazo" id="id-251086d274d34045a96f496305f92c88">
        <documentation>A empresa precisa da folha de papel preenchida, sem lacunas, no fim de cada mês.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Fim do mês exige garimpar conversas" id="id-04b8f8b5ec5549d1abdf7a0d172466cb">
        <documentation>Juntar os horários vira um trabalho à parte, repetitivo e sujeito a erro (README).</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="App atual depende de servidor na rede de casa" id="id-9b679e73917e40dabb9178755e49f0fe">
        <documentation>O web-app roda num celular velho com Termux; fora de casa, não abre.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Regras duplicadas em Python e Dart" id="id-2ad49851b7a947f9ad7a3a0f5152ddab">
        <documentation>calculate_status existe em services.py e em status.dart, mantidos juntos por vetores golden.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Sem backup dos dados" id="id-edda0107982e451a87e35c282a39b467">
        <documentation>Perder ou trocar o celular perde o histórico (consequência registrada no ADR-001).</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Preencher a folha do mês sem garimpo" id="id-3d7ddcd9b3884bcab9c85220a788ae02">
        <documentation>Ter tudo do mês num só lugar, na ordem da folha de papel.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Registrar o ponto na hora, em segundos" id="id-a8fe0fcb2cfb474d9f4b90c4ac843fa2">
        <documentation>A anotação acontece no momento do evento, com um toque.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Funcionar em qualquer rede, sem internet" id="id-77664c699caa448baf0157f91cb00621">
        <documentation>Inclusive dentro da rede da empresa.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Manter o projeto simples de evoluir" id="id-48da7a61e6b74bbe8a14642c0201ff88">
        <documentation>Uma pilha, poucos arquivos, testes rápidos. Fácil de estudar e de mudar.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Não perder o histórico" id="id-eaf262d059e8404cb394f7c93f0cfb06">
        <documentation>O usuário consegue guardar e restaurar os próprios dados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Folha copiada numa só sessão" id="id-a871d888565c4e88827421b4765fb41c">
        <documentation>Sem abrir o WhatsApp nem consultar outro calendário.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Nenhum dia útil esquecido" id="id-cb343636b85c439bac36edfb66d59343">
        <documentation>O app aponta todo dia útil sem lançamento ou incompleto.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Ponto batido no momento em que acontece" id="id-5fb926fa10bf460f9e2e5ec01daa7152">
        <documentation>Em até 2 toques a partir do ícone do app.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Bater o ponto em até 2 toques" id="id-40e740c354c3418e8f723109adb56ba9">
        <documentation>UC01, RNF04.</documentation>
        <property key="caso de uso" value="UC01" />
      </element>
      <element xsi:type="archimate:Requirement" name="Sugerir feriados e emendas automaticamente" id="id-acff99807c8b4b7fa790f89ea61317af">
        <documentation>Nacionais e de SP pela lib holidays; Cubatão e emendas da empresa cadastrados. Emenda = folga.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:Requirement" name="Listar as pendências do mês" id="id-e8070fea12004972a4bbf0dfbf30a32d">
        <documentation>Dia útil sem lançamento, lançamento incompleto, emenda a confirmar.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:Requirement" name="Mostrar o mês na ordem da folha de papel" id="id-af17e8ad5dd24f958c5ded0dcaea364d">
        <documentation>DIA · Manhã E/S · Tarde E/S · Extra E/S · observação, dias 01 a 31 corridos.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar hora extra" id="id-5ed05c8c2d2146f2862ccf2fab3b6901">
        <documentation>Par de marcações Extra (entrada/saída), como na folha oficial.</documentation>
        <property key="caso de uso" value="UC01, UC02" />
      </element>
      <element xsi:type="archimate:Requirement" name="Backup e restauração por arquivo" id="id-419086b649ca47718b3211fde43973be">
        <documentation>JSON versionado, mesclar ou substituir.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:Constraint" name="APK sem permissão de internet" id="id-a814bfe8618340499a4698176a39d3b7">
        <documentation>RNF01. Um teste reprova qualquer import de rede.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Python ≥ 3.12 gerenciado com uv" id="id-90deb37e282e477a98febc9fe72c3a6e">
        <documentation>RNF02. Decisão do usuário.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Folha oficial em papel, preenchida à mão" id="id-90dea801cb874d6da47a1e430b8987a9">
        <documentation>O app não substitui a folha: ele organiza o que vai ser copiado para ela.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-864c6eaf42114733851c114ffe09b6d9" type="implementation_migration">
    <folder name="E-F. Roadmap" id="id-6cebdd063d654d4e96d4c4f91dc813a6">
      <element xsi:type="archimate:Plateau" name="Baseline (nov/2026)" id="id-b70ccca379e34a51809e58030631c363">
        <documentation>Três pilhas, servidor no celular velho, rede de casa.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 1: núcleo Python testado" id="id-e8dec9ca8f61421f8297604a668e547d">
        <documentation>Domínio, calendário e SQLite com pytest; uma CLI mínima no PC já registra e mostra a folha.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 2: app Flet no PC" id="id-6657b2bc4a0b449ba229176b89b8077a">
        <documentation>Mesmas telas do celular rodando com `uv run`.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Target: APK offline no celular" id="id-3e84efcf073f4409aeef7b94eaa544da">
        <documentation>App instalado, sem rede, com backup.</documentation>
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar servidor, API e API key" id="id-db94fda400954eb4a5785f5e7c5d4410">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar React, Flutter e regras em Dart" id="id-fbb41375ec634d4299e77a4401171e0d">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar orquestrador, skills e Mongo/Docker" id="id-40583e3d7af0483b968bb263317e33be">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Manter regras de status e vocabulário" id="id-0eb30d9394fc44469b0f1cb2a099be38">
        <documentation>Operação: keep.</documentation>
        <property key="operacao" value="keep" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar app Python offline com SQLite" id="id-ee3fa889b4d64f738ab92d242f4feeff">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar calendário de feriados e emendas" id="id-410b803f4b8e4067ba8e1ba5ebbf32f6">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar fechamento do mês (pendências + folha)" id="id-d7d66cff3feb44b28f82e7edb9091639">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar backup e restauração" id="id-f9436d9228d5491a93bde37ed68df0d8">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar anotações no WhatsApp" id="id-eb0865c94308416fae4a6672bfe735d7">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Trocar a pesquisa de feriados por sugestão do app" id="id-45f41f4a64de4abbb1a475a9782fa8ea">
        <documentation>Operação: eliminate + create.</documentation>
        <property key="operacao" value="eliminate + create" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP1 Limpar o repositório" id="id-2df4b53ccc0942acb5c11d3d0cf5f4f6">
        <documentation>Remover Django, React, Flutter, orquestrador, skills, Mongo/Docker. Escrever o ADR-002.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP2 Domínio + contrato em Python" id="id-83435f0dc0f6459fabcf7961571be0ab">
        <documentation>Status, validação, ordem, horas e extra; vetores golden em pytest.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP3 Repositório SQLite" id="id-9b3c0e582ac14c1c9c880abdd33088ca">
        <documentation>Schema, migrações e upsert por data.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP4 Calendário" id="id-fc47647825fa41ad964e9c78b0fa45ca">
        <documentation>lib holidays BR/SP, regra de emenda, datas de Cubatão.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP5 Telas Flet" id="id-e8c5f2dc7b654a6688c098e49ece29c7">
        <documentation>Hoje (bater ponto), Mês, Folha, Ajustes.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP6 Exportação e backup" id="id-91e31e5531e94497b79be44dcc79172e">
        <documentation>Folha em texto/CSV, backup/restauração JSON.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP7 APK e CI" id="id-0fd5f4200e504e1997427f34deeb335b">
        <documentation>flet build apk, teste de não-rede, workflow único.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:Deliverable" name="Repositório limpo + ADR-002" id="id-627f4dd04d7d418f9c7bfcfd51f87911">
        <documentation>README, CLAUDE.md e docs atualizados.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="Pacote folha_ponto testado" id="id-3d9bc2c407384607b0afe48000d9d23c">
        <documentation>Domínio, calendário e SQLite com pytest verde.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="App Flet funcional no PC" id="id-2d6cad8291e44bc3a20dc2ea354311fa">
        <documentation>Todos os casos de uso navegáveis.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="APK offline + CI" id="id-bad9b443725d479dba76ee4a41e10b7e">
        <documentation>Instalável no celular.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Other" id="id-f35b0879c80e428d8e8515026fa46bd5" type="other" />
