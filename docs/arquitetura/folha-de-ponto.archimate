<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Folha de Ponto Pessoal v2 (app offline)" id="id-30632c9b86654364b309aa30df713bb5" version="5.0.0">
  <folder name="Strategy" id="id-a7404335952b4398aaec9ced8f37c0bf" type="strategy">
    <folder name="A. Vision" id="id-4413e033b17148b992999e8f20b4cab6">
      <element xsi:type="archimate:CourseOfAction" name="Reescrever como app Python offline no celular" id="id-2d61f1494f164b3e85d77082cdf1f706">
        <documentation>Uma pilha só (Python + uv + SQLite + Flet), rodando no aparelho do Trabalhador.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Registro de jornada" id="id-05a0e540239047d4ada5f6f3c316951b">
        <documentation>Anotar marcações e classificar o dia.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Calendário de feriados e emendas" id="id-29fe7f8a4a55441b9243832b5371d527">
        <documentation>Feriados oficiais (lib pronta) + emendas e datas de Cubatão (sob medida).</documentation>
        <property key="subdominio DDD" value="Generic (lib holidays) + Supporting (emendas, municipais)" />
      </element>
      <element xsi:type="archimate:Capability" name="Fechamento da folha do mês" id="id-aad6d0f320a24bf0aa0e235262d862be">
        <documentation>Conferir pendências e copiar a folha.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Proteção dos dados" id="id-89aa1272c18a461b8ba9b4bc4a5c784e">
        <documentation>Backup e restauração.</documentation>
        <property key="subdominio DDD" value="Supporting" />
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-311208d52bd9479cb1a37a315d32e036" type="business">
    <folder name="B. Business" id="id-3758a0df96644628bb8edca142b76756">
      <element xsi:type="archimate:BusinessActor" name="Trabalhador" id="id-68e579c3d3a04104b1155d15d3e82e40">
        <documentation>Aprendiz que registra o próprio ponto. Único usuário do app.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Empresa" id="id-616fe69563f14edd8cf537d7f7fb1ce4">
        <documentation>Empregadora. Recebe a folha de ponto assinada.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Responsável pelo ponto" id="id-abfe151740b24a6eb1ce9410edec2230">
        <documentation>Anota, confere e preenche a própria folha.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Recebedor da folha" id="id-6472d0ff53d744c2bc33a6183bf7de37">
        <documentation>Recebe e arquiva a folha do mês.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Chegada, almoço ou saída" id="id-add6c4d020834919a001d4fe64239c0a">
        <documentation>Cada um dos momentos que geram uma marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Fim do mês" id="id-7c74f0da696f456b9289496619e8a9ae">
        <documentation>Hora de preencher e entregar a folha oficial.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Folha de ponto oficial (papel)" id="id-2e8935528aa74731a6d86574107facc7">
        <documentation>Uma linha por dia (01–31) com Manhã, Tarde e Extra (entrada/saída) e assinatura. Jornada 07:45–12:00 e 13:00–14:45.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Entregar a folha assinada" id="id-5b861cc0d6754825bc9e0e16e06e5ac9">
        <documentation>Igual na baseline e no target (keep).</documentation>
      </element>
    </folder>
    <folder name="B. 2 Baseline" id="id-c7b6cbcd69ca4113896d404087e718af">
      <element xsi:type="archimate:BusinessObject" name="Mensagens com horários (WhatsApp)" id="id-c0794ea0db7c48cca2bef8a4d2f1423c">
        <documentation>Anotações soltas, sem estrutura.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Calendário de cabeça / internet" id="id-f6e6f64eb86f431cab66d9f9ac1560ef">
        <documentation>Onde se descobre, no fim do mês, o que foi feriado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B1 Anotar horário no WhatsApp" id="id-9509a0ba7dc94e9bb8b08ff2f3b05a16">
        <documentation>Mensagem para si mesmo a cada marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B2 Rolar as conversas do mês" id="id-20b6a1eb713b43d8b80de74dc173907a">
        <documentation>Garimpar as mensagens, dia por dia.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B3 Descobrir feriados e emendas" id="id-e584642a3525420183c51876037516bf">
        <documentation>Lembrar ou pesquisar quais dias não eram úteis.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B4 Preencher a folha à mão" id="id-68d9678b23d8473abdb21799849db792">
        <documentation>Copiar o que foi garimpado para o papel.</documentation>
      </element>
    </folder>
    <folder name="B. 3 Target" id="id-9338647853c34a4296c71e6e18766bfe">
      <element xsi:type="archimate:BusinessObject" name="Registro do dia" id="id-0dea73e9e4e442fc801fa54ee490a716">
        <documentation>Data, tipo do dia, marcações Manhã/Tarde/Extra, observação e status (completo, incompleto, não trabalhado).</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T1 Bater o ponto no app" id="id-80c35581032e41afa84682837b175987">
        <documentation>Um toque grava a hora na próxima marcação vazia.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T2 Confirmar feriados e emendas sugeridos" id="id-bb8dacd43f4241d5a378696978d0dfd3">
        <documentation>O app sugere; o Trabalhador confirma. Emenda confirmada = folga.</documentation>
        <property key="caso de uso" value="UC03, UC10" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T3 Resolver as pendências do mês" id="id-1efe4ef35dd24a12be9e244c9fbf5f14">
        <documentation>Completar os dias úteis sem lançamento ou incompletos.</documentation>
        <property key="caso de uso" value="UC05, UC07" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T4 Copiar a folha pela tela Folha" id="id-dcb8a60f974a47e2a2c8a9c225503424">
        <documentation>Uma linha por dia, na ordem do papel. Marca cada linha copiada.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T6 Guardar o backup do mês" id="id-c3e64f6781a24e20838017ec740b4f89">
        <documentation>Gerar o arquivo e guardá-lo fora do celular.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
    </folder>
  </folder>
  <folder name="Application" id="id-a48460a553e340d2b7ea7e0ebb58cc6d" type="application">
    <folder name="C. 2 Baseline" id="id-84bdce4a605b471dbcd6059d7e86ea72">
      <element xsi:type="archimate:ApplicationComponent" name="API Django + DRF" id="id-fe7eb82a4b1d4bcb8753cfd22b041367">
        <documentation>src/backend: views → serializers → services → repositories, X-Api-Key.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Web React/Vite" id="id-939bdff8aaad4284b5d6c495033cf14c">
        <documentation>src/web: abas Hoje/Mês, calendário, tela de chave de API.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="App Flutter (sqflite)" id="id-d8e54a94d7764e3abd3c59487160dc99">
        <documentation>src/mobile: offline, regras portadas para Dart, adapter HTTP opcional.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Orquestrador multi-CLI" id="id-e04484eec50841ca91cb84b73bd78cb5">
        <documentation>orchestrator.sh (2 cópias): Claude Code builder + Antigravity auditor, agents/, skills/.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Gerador de contratos (Py/TS/Dart)" id="id-bf10bd33b5754bdf9a06147302282024">
        <documentation>contracts/generate.py escreve 3 alvos a partir de time_record.json.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="db.sqlite3 do servidor" id="id-a8826e76c4d843ef838032b0f0ead9dc">
        <documentation>Banco do Django, no celular-servidor.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="folha_de_ponto.db do Flutter" id="id-02ee8a1efe8a45ec974c2358c82102ed">
        <documentation>Banco independente do app Flutter, sem sync.</documentation>
      </element>
    </folder>
    <folder name="C. 3 Target" id="id-b93defe6452b48bba2a6751677810f80">
      <element xsi:type="archimate:ApplicationComponent" name="App Folha de Ponto (pacote folha_ponto)" id="id-a7e2527661684934923ac2e32955a015">
        <documentation>Um único pacote Python. Roda no celular (APK Flet) e no PC (uv run).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Interface (Flet)" id="id-7041cf6acdd74130ab256712efc2051d">
        <documentation>servicos.py orquestra os casos de uso sem Flet (testável); telas/ Hoje, Mês, Folha, Ajustes e o formulário do dia são finas e recebem um Contexto, não a Page.</documentation>
        <property key="modulo" value="folha_ponto/ui/" />
        <property key="subdominio DDD" value="Generic (framework Flet)" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Domínio: regras do dia" id="id-36118974f87a478489c710aed28f50c4">
        <documentation>Status, validação HH:MM e ordem das marcações, horas e saldo, pendências e folha do mês. Python puro.</documentation>
        <property key="modulo" value="folha_ponto/dominio/" />
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Calendário: feriados e emendas" id="id-941fda855228476a87d28d3b61f5ac07">
        <documentation>Gera o ano pela lib holidays (BR/UF, public + optional; UF desconhecida cai nos nacionais), aplica a regra de emenda (RN05, inclusive na virada do ano) sobre feriados, facultativos e datas manuais, e grava pelo Repositório. Confirma/descarta emendas (UC03) e cadastra datas manuais (UC10).</documentation>
        <property key="modulo" value="folha_ponto/calendario/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Repositório SQLite" id="id-7e291c8054e445adaa5f4f0f6b99b91d">
        <documentation>sqlite3 da stdlib, migrações por PRAGMA user_version, transações atômicas e trava para as threads do Flet. Único que fala SQL. Implementa a porta Calendario.</documentation>
        <property key="modulo" value="folha_ponto/dados/" />
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Exportação e backup" id="id-c82050c1cb9842b090dc73318ea26b0a">
        <documentation>Folha em texto/CSV; backup e restauração em JSON.</documentation>
        <property key="modulo" value="folha_ponto/exportacao/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Biblioteca holidays (Calendário oficial do Brasil)" id="id-ce2df49288084abda06759d257d4dc3b">
        <documentation>Dependência open source, offline. Ator secundário do UC06.</documentation>
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Telas Hoje · Mês · Folha · Ajustes" id="id-8214cb66767a4987a78cf573bf32c863">
        <documentation>O que o Trabalhador toca.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Registrar marcação" id="id-bb279d8206f940d186e6da18d8c87308">
        <documentation>Serviço que atende UC01, UC02, UC04.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Consultar mês" id="id-8b1e448d879c4cf09faf5dfa8d5ee86d">
        <documentation>Serviço que atende UC05.</documentation>
        <property key="caso de uso" value="UC05" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Sugerir feriados e emendas" id="id-606664c0809a4816842dd77677773cdf">
        <documentation>Serviço que atende UC03, UC06, UC10.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Listar pendências do mês" id="id-6c97c987758149588c885726cbdbaf08">
        <documentation>Serviço que atende UC07.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Gerar folha para cópia" id="id-277dbf96d3f54fbbbc283234107a9b86">
        <documentation>Serviço que atende UC08.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Backup e restauração" id="id-950825e9c9334787bcafe977bf0390c1">
        <documentation>Serviço que atende UC09.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Configurar preferências" id="id-30fbfd2d040c41079311403558ccb251">
        <documentation>Serviço que atende UC11.</documentation>
        <property key="caso de uso" value="UC11" />
      </element>
    </folder>
    <folder name="C. Dados" id="id-0ab148ec28684d1c8bb278bd7ea26a9e">
      <element xsi:type="archimate:DataObject" name="Lançamento do dia (tabela lancamentos)" id="id-24e2de5525f345bb98f9c7ccb6675d21">
        <documentation>data (única), tipo, entrada, saida_almoco, volta_almoco, saida, entrada_extra, saida_extra, observacao, criado_em, atualizado_em.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Data especial (tabela datas_especiais)" id="id-73748eb3e0904ed9aad52e3bd586d1fa">
        <documentation>data, nome, natureza (feriado, facultativo, emenda, emenda_sugerida), origem (nacional, estadual, facultativo, regra_emenda, manual), recorrente, oculta, fonte (versão da lib).</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Preferências (tabela preferencias)" id="id-053728edd77442089f88c562642e6e73">
        <documentation>UF, município, jornada padrão, facultativo conta como folga (padrão: sim), tema.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Vocabulário do domínio (vocabulario.py)" id="id-7d2f440d123f4dfb8a1d4181f3e27ead">
        <documentation>Enums TipoDia, Status e Marcacao: fonte única dos termos. Sucede o contracts/time_record.json da v1.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Arquivo de backup (JSON)" id="id-5873add297f4454e9816a215d2a47744">
        <documentation>Versionado; lançamentos, datas manuais, emendas confirmadas, preferências.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Folha do mês (texto/CSV)" id="id-690073d9ce244537b9824b214a85f4f2">
        <documentation>Mesma ordem de colunas do papel.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-0a6e56fec0bc4ea2a816871c505963fa" type="technology">
    <folder name="D. 2 Baseline" id="id-f51b8458f45841f8815797dea9fffeb9">
      <element xsi:type="archimate:Device" name="Celular velho (Termux + sshd)" id="id-1c311eb695ed45008404c194961b10c4">
        <documentation>Servidor Django na Wi-Fi de casa, porta 8000. Sai do projeto.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC na rede de casa (WSL2)" id="id-e1f834a0ff024dfc96f3f4598f0929ab">
        <documentation>Build do frontend e deploy por SSH (scripts/deploy-celular.sh).</documentation>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="Wi-Fi de casa" id="id-6b783efdb1cb4aabbb4c73c577b854af">
        <documentation>Única rede onde o app atual funciona.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Docker + MongoDB + Caddy" id="id-f9571e422a6b42db9f70e20d86a1baa7">
        <documentation>Restos do plano original. Nunca usados pelo código atual.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (Django, Flutter, contratos)" id="id-0c5205104f2b4f8cbaba70355cec1d04">
        <documentation>3 workflows.</documentation>
      </element>
    </folder>
    <folder name="D. 3 Target" id="id-8e1d2c87025e48a183bdca9066a74551">
      <element xsi:type="archimate:Device" name="Celular Android do Trabalhador" id="id-70d751c2ab1f443b93a09e2acc9dfd19">
        <documentation>O mesmo aparelho que vai no bolso. Nada roda fora dele.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Android" id="id-50eb3aad04214a519d3f2ef07e4487e4">
        <documentation>Sem permissão INTERNET no manifest.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Python embarcado (Flet)" id="id-97b77da64dd24f94a815d5dfa4817332">
        <documentation>Runtime Python empacotado no APK pelo flet build.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="SQLite (sqlite3 da stdlib)" id="id-22ede33f6092450982b084f0bcfeaf60">
        <documentation>Banco embutido, arquivo único.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Armazenamento privado do app" id="id-50362d2b91ed49a5ad23fa25b73829ca">
        <documentation>Diretório de dados do app, apagado só na desinstalação.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Compartilhamento do Android" id="id-3ef0f69d8f3145bb9417f61d140238f5">
        <documentation>Menu Compartilhar: salvar, WhatsApp, e-mail, Drive.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha-de-ponto.apk" id="id-d8e9f985e16e47b6b0f1517911e11ed4">
        <documentation>Gerado por `uv run flet build apk`.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha_de_ponto.db" id="id-01ad8d3be59d46278cf9390b65dd9695">
        <documentation>Arquivo SQLite com lancamentos, datas_especiais e preferencias. Pasta: FLET_APP_STORAGE_DATA.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="backup-AAAA-MM-DD.json" id="id-39a3a85664f14b83bc0e0f45b76e0207">
        <documentation>Arquivo de backup que o usuário guarda fora do celular.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC de desenvolvimento" id="id-d2f7effcf8f34bbba102546379cb2811">
        <documentation>Onde se programa, testa e gera o APK.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="uv + Python 3.12" id="id-8da45c97732f4f1f905a121bd796ea1c">
        <documentation>uv sync, uv run, uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="pytest" id="id-84393db6c17b400ca6d654e4f4e04d66">
        <documentation>Testes do domínio, do calendário e do SQLite, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (pytest + build APK)" id="id-ac15c48885b540c4b915a42c3758d321">
        <documentation>Um workflow só.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="Pacote folha_ponto (pyproject.toml + uv.lock)" id="id-57ab9fe0d8e1485b95be3c4d60d7ff2c">
        <documentation>Código-fonte versionado no git.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyProcess" name="Gerar o APK" id="id-92ea818e4fe14f14bccf4245e235f86f">
        <documentation>flet build apk a partir do pacote.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Motivation" id="id-e8002e514b0a46e88dce3a4d3be4f22e" type="motivation">
    <folder name="0. Preliminar" id="id-672dbbdf9c9b4b178a4fec10ed32f56e">
      <element xsi:type="archimate:Principle" name="Offline primeiro (local-first)" id="id-61fbaf5f40514432bcbb2271a8ced118">
        <documentation>O app funciona sem rede, em qualquer lugar. Nenhum caminho de uso depende de servidor ou internet.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Simplicidade antes de generalidade" id="id-e90bd65e1de54cc4a4dac6f44bed70da">
        <documentation>Uma única pilha e um único banco. Só se adiciona peça quando um caso de uso precisa dela.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Uma linguagem: Python com uv" id="id-934d514416e64de88153ad4b9cba44ca">
        <documentation>Regras, persistência, calendário e interface em Python. Dependências fixadas em pyproject.toml + uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Regras testáveis sem interface" id="id-79d359fc29894cdaa130a7bd3040c402">
        <documentation>Domínio e calendário em Python puro, testados com pytest no PC, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Dados do usuário no aparelho e sob controle dele" id="id-d130d4dcc6524fa28e309024b99b882f">
        <documentation>Os lançamentos ficam no SQLite do app. O backup é um arquivo que o próprio usuário guarda.</documentation>
      </element>
    </folder>
    <folder name="A. Vision" id="id-33144612093a4c65b6ea8a48cf28a332">
      <element xsi:type="archimate:Stakeholder" name="Trabalhador (aprendiz)" id="id-ec6375656f0c4178aa3dfdad716ab32d">
        <documentation>Dono da folha de ponto. Anota os horários todo dia e preenche a folha oficial no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Empresa (RH / supervisor)" id="id-66296b50c0ba4335afd2f5edd6bd54ab">
        <documentation>Recebe a folha de ponto preenchida e assinada no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Horários espalhados no WhatsApp" id="id-a8697aaf1caa4ac2857d15e0285137cb">
        <documentation>Entrada, almoço, volta e saída ficam em mensagens soltas ao longo de semanas.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Rede da empresa bloqueia APIs externas" id="id-4233c722ac0c4015aebb398654ad8712">
        <documentation>No trabalho não dá para depender de servidor em casa nem de API na internet.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Feriados e emendas esquecidos" id="id-cea537fab0ff40f18a3d59be428f84c1">
        <documentation>No fim do mês é preciso lembrar quais dias foram feriado, ponto facultativo ou emenda.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Complexidade acidental do repositório" id="id-64740c00966f46cbaf5b1a03f3866ed2">
        <documentation>Django, React, Flutter, orquestrador multi-CLI e restos de MongoDB convivem para um app de uma pessoa.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Folha oficial correta e no prazo" id="id-a20f996bab6947e68a0821ff0f44cb46">
        <documentation>A empresa precisa da folha de papel preenchida, sem lacunas, no fim de cada mês.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Fim do mês exige garimpar conversas" id="id-587f62279e764efd99be6281d90607d2">
        <documentation>Juntar os horários vira um trabalho à parte, repetitivo e sujeito a erro (README).</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="App atual depende de servidor na rede de casa" id="id-1ef406767e07441d9320fca2b59a7c93">
        <documentation>O web-app roda num celular velho com Termux; fora de casa, não abre.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Regras duplicadas em Python e Dart" id="id-176459095cb5433aa5fcd044d1d1bfb5">
        <documentation>calculate_status existe em services.py e em status.dart, mantidos juntos por vetores golden.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Sem backup dos dados" id="id-a81677cd95454f4cad5e9acfc402c3a2">
        <documentation>Perder ou trocar o celular perde o histórico (consequência registrada no ADR-001).</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Preencher a folha do mês sem garimpo" id="id-35fcad93841e433d8656ea7b0c0c0be5">
        <documentation>Ter tudo do mês num só lugar, na ordem da folha de papel.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Registrar o ponto na hora, em segundos" id="id-6297584395cc427a9dfbb3ecc9f79c49">
        <documentation>A anotação acontece no momento do evento, com um toque.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Funcionar em qualquer rede, sem internet" id="id-8e7bdf0301894db1b6c6342e4610313a">
        <documentation>Inclusive dentro da rede da empresa.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Manter o projeto simples de evoluir" id="id-254769d65cc34665822f11ee6554a895">
        <documentation>Uma pilha, poucos arquivos, testes rápidos. Fácil de estudar e de mudar.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Não perder o histórico" id="id-8a1fdd3fba584fa499192fa326582506">
        <documentation>O usuário consegue guardar e restaurar os próprios dados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Folha copiada numa só sessão" id="id-21cb013ee971469e946e169ae44b9cac">
        <documentation>Sem abrir o WhatsApp nem consultar outro calendário.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Nenhum dia útil esquecido" id="id-c4807914b31040fa987d227be8ba306d">
        <documentation>O app aponta todo dia útil sem lançamento ou incompleto.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Ponto batido no momento em que acontece" id="id-065a761468f648fabffb90f6663038d8">
        <documentation>Em até 2 toques a partir do ícone do app.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Bater o ponto em até 2 toques" id="id-058ceed9958f48e3988f9f9362970b58">
        <documentation>UC01, RNF04.</documentation>
        <property key="caso de uso" value="UC01" />
      </element>
      <element xsi:type="archimate:Requirement" name="Sugerir feriados e emendas automaticamente" id="id-a41dcf6921fe4286bf13ab2a147ed809">
        <documentation>Nacionais e de SP pela lib holidays; Cubatão e emendas da empresa cadastrados. Emenda = folga.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:Requirement" name="Listar as pendências do mês" id="id-441f53bcfb924a9abb44858f860046f5">
        <documentation>Dia útil sem lançamento, lançamento incompleto, emenda a confirmar.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:Requirement" name="Mostrar o mês na ordem da folha de papel" id="id-48ce0e2836764f9dbb3191cf168d0386">
        <documentation>DIA · Manhã E/S · Tarde E/S · Extra E/S · observação, dias 01 a 31 corridos.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar hora extra" id="id-14b9368daea24a17a050260576e7d61c">
        <documentation>Par de marcações Extra (entrada/saída), como na folha oficial.</documentation>
        <property key="caso de uso" value="UC01, UC02" />
      </element>
      <element xsi:type="archimate:Requirement" name="Backup e restauração por arquivo" id="id-112c2072c264458eb67f0ccedde52054">
        <documentation>JSON versionado, mesclar ou substituir.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:Constraint" name="APK sem permissão de internet" id="id-f31d5b173f614d5880900aefd4eb5779">
        <documentation>RNF01. Um teste reprova qualquer import de rede.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Python ≥ 3.12 gerenciado com uv" id="id-28b22efceaca482c9e88ce4c1a3fd70e">
        <documentation>RNF02. Decisão do usuário.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Folha oficial em papel, preenchida à mão" id="id-27fc9ab0cadc445e929c5befe9bc5478">
        <documentation>O app não substitui a folha: ele organiza o que vai ser copiado para ela.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-18e0732e4e984e459b82311d2693b248" type="implementation_migration">
    <folder name="E-F. Roadmap" id="id-cc381e493e274d37b790cc23f98d9452">
      <element xsi:type="archimate:Plateau" name="Baseline (nov/2026)" id="id-b103bc47adbb465298c9f684adb98d35">
        <documentation>Três pilhas, servidor no celular velho, rede de casa.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 1: núcleo Python testado" id="id-66edbe47bd7b44f8826ae72b5ff71d7c">
        <documentation>Domínio, calendário e SQLite com pytest; uma CLI mínima no PC já registra e mostra a folha.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 2: app Flet no PC" id="id-041943ef5aa6480bb5e97780d3626440">
        <documentation>Mesmas telas do celular rodando com `uv run`.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Target: APK offline no celular" id="id-c4650294a0724b60b5ff7044abb7fefe">
        <documentation>App instalado, sem rede, com backup.</documentation>
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar servidor, API e API key" id="id-3d911ead22bc496b8dea22696e00b28f">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar React, Flutter e regras em Dart" id="id-4d0494bc3b744dbf94b5bcc78e29d545">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar orquestrador, skills e Mongo/Docker" id="id-cc414c5b7a674a8e90f1dcab131b5e32">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Manter regras de status e vocabulário" id="id-163e68ca5dff4cd8a78288327f429ca6">
        <documentation>Operação: keep.</documentation>
        <property key="operacao" value="keep" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar app Python offline com SQLite" id="id-7bff50b92d0f43a48b5ee34acb7b2d87">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar calendário de feriados e emendas" id="id-294c898eabdb4a17ae6ba1f3331bfc33">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar fechamento do mês (pendências + folha)" id="id-60006a3180fb4b60b2b11ad0d1065e13">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar backup e restauração" id="id-770facdf9bb94c35a842a6b9dcd1960c">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar anotações no WhatsApp" id="id-03c9a748e4284ce1b9670b9fd8963891">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Trocar a pesquisa de feriados por sugestão do app" id="id-ff8129f8aacc4f7f874ff80809a6f24c">
        <documentation>Operação: eliminate + create.</documentation>
        <property key="operacao" value="eliminate + create" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP1 Limpar o repositório" id="id-eccdd82ea8944873a685f3a6318be3e8">
        <documentation>Remover Django, React, Flutter, orquestrador, skills, Mongo/Docker. Escrever o ADR-002.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP2 Domínio + contrato em Python" id="id-ca7e3f087b444b4fa59641f6a57f8c99">
        <documentation>Status, validação, ordem, horas e extra; vetores golden em pytest.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP3 Repositório SQLite" id="id-997e27021b324274a44e2db62e85d1ed">
        <documentation>Schema, migrações e upsert por data.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP4 Calendário" id="id-cc2e1097d61e4ac8911fd3773a9b9612">
        <documentation>lib holidays BR/SP, regra de emenda, datas de Cubatão.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP5 Telas Flet" id="id-847115aaad154e2dbbb60048c6a864b0">
        <documentation>Hoje (bater ponto), Mês, Folha, Ajustes.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP6 Exportação e backup" id="id-494f644667804edbad9b999e638409d6">
        <documentation>Folha em texto/CSV, backup/restauração JSON.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP7 APK e CI" id="id-358f00e9803e48d388be412a9383c595">
        <documentation>flet build apk, teste de não-rede, workflow único.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:Deliverable" name="Repositório limpo + ADR-002" id="id-a4a496ed565b477b829038a2d36f69df">
        <documentation>README, CLAUDE.md e docs atualizados.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="Pacote folha_ponto testado" id="id-726ac95b154f422eb20a24fb3a46c2f1">
        <documentation>Domínio, calendário e SQLite com pytest verde.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="App Flet funcional no PC" id="id-0d0d30d282e6443197c97feaa4c67a6b">
        <documentation>Todos os casos de uso navegáveis.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="APK offline + CI" id="id-fa552499af754a0b8186805343465a30">
        <documentation>Instalável no celular.</documentation>
      </element>
    </folder>
  </folder>
