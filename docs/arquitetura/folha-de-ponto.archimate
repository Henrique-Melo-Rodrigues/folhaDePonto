<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Folha de Ponto Pessoal v2 (app offline)" id="id-32f1aa6069324b3582b038444521f094" version="5.0.0">
  <folder name="Strategy" id="id-1e01ed12114c4e358a36771344126d62" type="strategy">
    <folder name="A. Vision" id="id-be253adae06a4b4d88e103163734b13c">
      <element xsi:type="archimate:CourseOfAction" name="Reescrever como app Python offline no celular" id="id-30464590a4b04d78b1857645433c1bb1">
        <documentation>Uma pilha só (Python + uv + SQLite + Flet), rodando no aparelho do Trabalhador.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Registro de jornada" id="id-f0845ae46bc5496097f5b922d9d4d9db">
        <documentation>Anotar marcações e classificar o dia.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Calendário de feriados e emendas" id="id-5b4dafccfce443f1af8f6d7a4da1ff05">
        <documentation>Feriados oficiais (lib pronta) + emendas e datas de Cubatão (sob medida).</documentation>
        <property key="subdominio DDD" value="Generic (lib holidays) + Supporting (emendas, municipais)" />
      </element>
      <element xsi:type="archimate:Capability" name="Fechamento da folha do mês" id="id-e4267104b7024d8891d7d4e912e81bce">
        <documentation>Conferir pendências e copiar a folha.</documentation>
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:Capability" name="Proteção dos dados" id="id-60c7f052edcd492fbc485c0c8805b60e">
        <documentation>Backup e restauração.</documentation>
        <property key="subdominio DDD" value="Supporting" />
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-5b0b75ca7f49410499bc6ef21c8c29db" type="business">
    <folder name="B. Business" id="id-2e02ae59d0e1407aabd70ec5eff950ce">
      <element xsi:type="archimate:BusinessActor" name="Trabalhador" id="id-b095eb3dc79a406e883ba47273db5aa2">
        <documentation>Aprendiz que registra o próprio ponto. Único usuário do app.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Empresa" id="id-0a1e9df8995548bca0b661500f8e18f9">
        <documentation>Empregadora. Recebe a folha de ponto assinada.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Responsável pelo ponto" id="id-478d7ac8069948d9aa1f2ceef640b5ff">
        <documentation>Anota, confere e preenche a própria folha.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Recebedor da folha" id="id-db5dc00c1a2848aabe1c47e79172cd3d">
        <documentation>Recebe e arquiva a folha do mês.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Chegada, almoço ou saída" id="id-97ab234e0dc54cdf85a214bd0578bc63">
        <documentation>Cada um dos momentos que geram uma marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Fim do mês" id="id-ab42ee09e2b545e59f3c9a804ab66380">
        <documentation>Hora de preencher e entregar a folha oficial.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Folha de ponto oficial (papel)" id="id-c97d316488644605a9e87e51081d7686">
        <documentation>Uma linha por dia (01–31) com Manhã, Tarde e Extra (entrada/saída) e assinatura. Jornada 07:45–12:00 e 13:00–14:45.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Entregar a folha assinada" id="id-bc229372e444488db4a3a72992244a8f">
        <documentation>Igual na baseline e no target (keep).</documentation>
      </element>
    </folder>
    <folder name="B. 2 Baseline" id="id-15f1d4652a22430eab7104986a81f73c">
      <element xsi:type="archimate:BusinessObject" name="Mensagens com horários (WhatsApp)" id="id-12c71d0e9b9340ae980ab9c4c7d0507b">
        <documentation>Anotações soltas, sem estrutura.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Calendário de cabeça / internet" id="id-d9d6a92b7bdc447485635c44ac63f6e3">
        <documentation>Onde se descobre, no fim do mês, o que foi feriado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B1 Anotar horário no WhatsApp" id="id-4aa58ed0ee47449d8083708ea0443e3a">
        <documentation>Mensagem para si mesmo a cada marcação.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B2 Rolar as conversas do mês" id="id-400ce476212a470cab1fd89565e8669c">
        <documentation>Garimpar as mensagens, dia por dia.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B3 Descobrir feriados e emendas" id="id-5ffbd0f85764497094b9aca7aab12a87">
        <documentation>Lembrar ou pesquisar quais dias não eram úteis.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="B4 Preencher a folha à mão" id="id-1b784a8974b342b7888e08cbc0a2b6f6">
        <documentation>Copiar o que foi garimpado para o papel.</documentation>
      </element>
    </folder>
    <folder name="B. 3 Target" id="id-be965c8b950d48de907b04f2dbe0d2fd">
      <element xsi:type="archimate:BusinessObject" name="Registro do dia" id="id-f23d942002204668aad60f62b8e15adc">
        <documentation>Data, tipo do dia, marcações Manhã/Tarde/Extra, observação e status (completo, incompleto, não trabalhado).</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T1 Bater o ponto no app" id="id-6098ada7116243999092400245bc9e23">
        <documentation>Um toque grava a hora na próxima marcação vazia.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T2 Confirmar feriados e emendas sugeridos" id="id-9fdd068cb0ae4b24a5ae3b0252859dd6">
        <documentation>O app sugere; o Trabalhador confirma. Emenda confirmada = folga.</documentation>
        <property key="caso de uso" value="UC03, UC10" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T3 Resolver as pendências do mês" id="id-14a06dff6d1244279e545bee9aeca7f7">
        <documentation>Completar os dias úteis sem lançamento ou incompletos.</documentation>
        <property key="caso de uso" value="UC05, UC07" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T4 Copiar a folha pela tela Folha" id="id-fd2748704c3a4d4c96c5344154bb7d05">
        <documentation>Uma linha por dia, na ordem do papel. Marca cada linha copiada.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="T6 Guardar o backup do mês" id="id-671d0dbc302d413c97e0a74357fb919b">
        <documentation>Gerar o arquivo e guardá-lo fora do celular.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
    </folder>
  </folder>
  <folder name="Application" id="id-361e6e440f714ce99f1564738d84ddf7" type="application">
    <folder name="C. 2 Baseline" id="id-385186ddcb25468d8e3dc356af3cc090">
      <element xsi:type="archimate:ApplicationComponent" name="API Django + DRF" id="id-13b0037ff6b246aa8c2cc4d74e13f342">
        <documentation>src/backend: views → serializers → services → repositories, X-Api-Key.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Web React/Vite" id="id-0032cac10b9645b6b010d11b886f690f">
        <documentation>src/web: abas Hoje/Mês, calendário, tela de chave de API.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="App Flutter (sqflite)" id="id-a67faca14b95446bad8c01c0b75f1bfd">
        <documentation>src/mobile: offline, regras portadas para Dart, adapter HTTP opcional.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Orquestrador multi-CLI" id="id-2498913cad7a454c862fad8401b72317">
        <documentation>orchestrator.sh (2 cópias): Claude Code builder + Antigravity auditor, agents/, skills/.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Gerador de contratos (Py/TS/Dart)" id="id-57ef5d93a9a94f28bcfa4e9d6a2afd97">
        <documentation>contracts/generate.py escreve 3 alvos a partir de time_record.json.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="db.sqlite3 do servidor" id="id-e131f83730744961863ec133ac80d404">
        <documentation>Banco do Django, no celular-servidor.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="folha_de_ponto.db do Flutter" id="id-19145365bf234e61baa09ab43befa2e9">
        <documentation>Banco independente do app Flutter, sem sync.</documentation>
      </element>
    </folder>
    <folder name="C. 3 Target" id="id-5401d04c7eda453e84f9bc94cd80dcad">
      <element xsi:type="archimate:ApplicationComponent" name="App Folha de Ponto (pacote folha_ponto)" id="id-7b8ede8ea73843f4988f99cf8e2a0a06">
        <documentation>Um único pacote Python. Roda no celular (APK Flet) e no PC (uv run).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Interface (Flet)" id="id-92d3543840584176845dcfb3200e5770">
        <documentation>Telas finas: só chamam os serviços do domínio.</documentation>
        <property key="modulo" value="folha_ponto/ui/" />
        <property key="subdominio DDD" value="Generic (framework Flet)" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Domínio: regras do dia" id="id-2b054a99fcca49d58d01a67548d4a016">
        <documentation>Status, validação HH:MM e ordem das marcações, horas e saldo, pendências e folha do mês. Python puro.</documentation>
        <property key="modulo" value="folha_ponto/dominio/" />
        <property key="subdominio DDD" value="Core" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Calendário: feriados e emendas" id="id-8d530522c1914ff69d142e9d6f6cf6af">
        <documentation>Gera o ano pela lib holidays (BR/SP, public + optional), aplica a regra de emenda e mescla as datas manuais.</documentation>
        <property key="modulo" value="folha_ponto/calendario/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Repositório SQLite" id="id-64350451713448aeb4fe2c4a58967485">
        <documentation>sqlite3 da stdlib, migrações por PRAGMA user_version. Único que fala SQL.</documentation>
        <property key="modulo" value="folha_ponto/dados/" />
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Exportação e backup" id="id-186c871aba4a4b3cadec97b37be1234c">
        <documentation>Folha em texto/CSV; backup e restauração em JSON.</documentation>
        <property key="modulo" value="folha_ponto/exportacao/" />
        <property key="subdominio DDD" value="Supporting" />
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Biblioteca holidays (Calendário oficial do Brasil)" id="id-08a6bfebaec948a985318d53998391f9">
        <documentation>Dependência open source, offline. Ator secundário do UC06.</documentation>
        <property key="subdominio DDD" value="Generic" />
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Telas Hoje · Mês · Folha · Ajustes" id="id-fb61e8f0e28c442f8eb2c628bd8d3037">
        <documentation>O que o Trabalhador toca.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Registrar marcação" id="id-43f3da8258da46b4991fabfe8b220016">
        <documentation>Serviço que atende UC01, UC02, UC04.</documentation>
        <property key="caso de uso" value="UC01, UC02, UC04" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Consultar mês" id="id-3cce6b902bd344f082a59628c44ed14c">
        <documentation>Serviço que atende UC05.</documentation>
        <property key="caso de uso" value="UC05" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Sugerir feriados e emendas" id="id-4f5be77534e943b0b71aab73f1d18c9b">
        <documentation>Serviço que atende UC03, UC06, UC10.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Listar pendências do mês" id="id-853a380e0db64053a307c36e462efb66">
        <documentation>Serviço que atende UC07.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Gerar folha para cópia" id="id-07e697029abe402283dffeb358fb6149">
        <documentation>Serviço que atende UC08.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Backup e restauração" id="id-57373074279a46efb61119b49a53d593">
        <documentation>Serviço que atende UC09.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:ApplicationService" name="Configurar preferências" id="id-7031fc47eea74b8a9d7cf2013054c103">
        <documentation>Serviço que atende UC11.</documentation>
        <property key="caso de uso" value="UC11" />
      </element>
    </folder>
    <folder name="C. Dados" id="id-aae99ffcb1094d7ea6d2474a53d17e6a">
      <element xsi:type="archimate:DataObject" name="Lançamento do dia (time_records)" id="id-dae35115b42d4e8fbc065fab54b14f60">
        <documentation>data (única), tipo, entrada, saida_almoco, volta_almoco, saida, entrada_extra, saida_extra, observacao, criado_em, atualizado_em.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Data do calendário (calendar_days)" id="id-65a53e65920941cdbadc3282e46a46fe">
        <documentation>date, nome, origem (nacional, estadual, facultativo, manual, emenda), confirmada, versão da lib.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Preferências (settings)" id="id-e2ec27056e484f919b1955e928fab0eb">
        <documentation>UF, município, jornada padrão, facultativo conta como folga (padrão: sim), tema.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Vocabulário do domínio (vocabulario.py)" id="id-ef75aa7d82df481b9fed5756484c264e">
        <documentation>Enums TipoDia, Status e Marcacao: fonte única dos termos. Sucede o contracts/time_record.json da v1.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Arquivo de backup (JSON)" id="id-931d2579b62a42589a56b6391e06de43">
        <documentation>Versionado; lançamentos, datas manuais, emendas confirmadas, preferências.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Folha do mês (texto/CSV)" id="id-8e470cdc786d48628a2c7ffe8ce424b8">
        <documentation>Mesma ordem de colunas do papel.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-e478d156ca924621b452a52bac41e1b7" type="technology">
    <folder name="D. 2 Baseline" id="id-70a9f03a9f494cfc99058e229b271997">
      <element xsi:type="archimate:Device" name="Celular velho (Termux + sshd)" id="id-b5a089a44feb4c61bfd47e3a3ccb582d">
        <documentation>Servidor Django na Wi-Fi de casa, porta 8000. Sai do projeto.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC na rede de casa (WSL2)" id="id-6da5e7152a7748fa9e8ae267f77d6895">
        <documentation>Build do frontend e deploy por SSH (scripts/deploy-celular.sh).</documentation>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="Wi-Fi de casa" id="id-47f90dec75564be19cef45294a8b4b15">
        <documentation>Única rede onde o app atual funciona.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Docker + MongoDB + Caddy" id="id-c022fc63c1464271a6a2df76b1c63270">
        <documentation>Restos do plano original. Nunca usados pelo código atual.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (Django, Flutter, contratos)" id="id-9d6cfa8eb2934615be959957df803fb0">
        <documentation>3 workflows.</documentation>
      </element>
    </folder>
    <folder name="D. 3 Target" id="id-5df90c585f1847f2842b9a6fec22ef81">
      <element xsi:type="archimate:Device" name="Celular Android do Trabalhador" id="id-f801bd45809d4782a365cca3fbe9a90d">
        <documentation>O mesmo aparelho que vai no bolso. Nada roda fora dele.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Android" id="id-425fd1ad5db845ef8c7224f6aedbaf43">
        <documentation>Sem permissão INTERNET no manifest.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Python embarcado (Flet)" id="id-c1b7b8c916f04433977de065dbb2ec18">
        <documentation>Runtime Python empacotado no APK pelo flet build.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="SQLite (sqlite3 da stdlib)" id="id-5e1c5e3ee85e4e90917e3ea1dae1d367">
        <documentation>Banco embutido, arquivo único.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Armazenamento privado do app" id="id-c49a60a47650400fb3181cc8a261b4b1">
        <documentation>Diretório de dados do app, apagado só na desinstalação.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Compartilhamento do Android" id="id-c19554501c9440749032c9d4c924b0d8">
        <documentation>Menu Compartilhar: salvar, WhatsApp, e-mail, Drive.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha-de-ponto.apk" id="id-3e2b9f05f07c497fa13790e32cc247fd">
        <documentation>Gerado por `uv run flet build apk`.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="folha_de_ponto.db" id="id-c0dc6a3457414c53a513e0de486d8dbe">
        <documentation>Arquivo SQLite com time_records, calendar_days e settings.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="backup-AAAA-MM-DD.json" id="id-110c72d7d4b94a03b40cd93e7e366f60">
        <documentation>Arquivo de backup que o usuário guarda fora do celular.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PC de desenvolvimento" id="id-47b7bb0afd314217ad8ee78b52bb15c3">
        <documentation>Onde se programa, testa e gera o APK.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="uv + Python 3.12" id="id-bb6db7ad188f4f3db2c4a7054795656a">
        <documentation>uv sync, uv run, uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="pytest" id="id-6190a1a83c834abeb20352fc6b545b15">
        <documentation>Testes do domínio, do calendário e do SQLite, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="GitHub Actions (pytest + build APK)" id="id-bec90d7372a648688ef601234c41bcdc">
        <documentation>Um workflow só.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="Pacote folha_ponto (pyproject.toml + uv.lock)" id="id-08c79ec9ad014c879de9006315fbd7b6">
        <documentation>Código-fonte versionado no git.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyProcess" name="Gerar o APK" id="id-85a5462a3d564ea4889adcec43555553">
        <documentation>flet build apk a partir do pacote.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Motivation" id="id-4388085e8ac44b6eafe0e5f6245baf38" type="motivation">
    <folder name="0. Preliminar" id="id-08e30624dc17443e8ff7b7d90d1a649f">
      <element xsi:type="archimate:Principle" name="Offline primeiro (local-first)" id="id-27e2da7a6253476bb11c9ad1ffa7a46e">
        <documentation>O app funciona sem rede, em qualquer lugar. Nenhum caminho de uso depende de servidor ou internet.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Simplicidade antes de generalidade" id="id-5cfe84ea795a4c8cb72b53776aaec916">
        <documentation>Uma única pilha e um único banco. Só se adiciona peça quando um caso de uso precisa dela.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Uma linguagem: Python com uv" id="id-46ff9e23210f44288149c720635c4b14">
        <documentation>Regras, persistência, calendário e interface em Python. Dependências fixadas em pyproject.toml + uv.lock.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Regras testáveis sem interface" id="id-f240829fe20d4fb28268f00cb5cfe12e">
        <documentation>Domínio e calendário em Python puro, testados com pytest no PC, sem emulador.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Dados do usuário no aparelho e sob controle dele" id="id-b217677b909145f39fbf979feb4297e6">
        <documentation>Os lançamentos ficam no SQLite do app. O backup é um arquivo que o próprio usuário guarda.</documentation>
      </element>
    </folder>
    <folder name="A. Vision" id="id-324e459298ef4f8db3bfef8ed59f4065">
      <element xsi:type="archimate:Stakeholder" name="Trabalhador (aprendiz)" id="id-ab8413c5a9b34c818cbf23774ce18aee">
        <documentation>Dono da folha de ponto. Anota os horários todo dia e preenche a folha oficial no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Empresa (RH / supervisor)" id="id-9bb9e5b28a5046a5b8dd889097c1db8f">
        <documentation>Recebe a folha de ponto preenchida e assinada no fim do mês.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Horários espalhados no WhatsApp" id="id-09369401c47d4f4e83ce2bf32dac3fdb">
        <documentation>Entrada, almoço, volta e saída ficam em mensagens soltas ao longo de semanas.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Rede da empresa bloqueia APIs externas" id="id-94be7f01f0854e2ea95b8df6f77b0844">
        <documentation>No trabalho não dá para depender de servidor em casa nem de API na internet.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Feriados e emendas esquecidos" id="id-4cecbadc6d1f4a42b9743dc89b8f5c8d">
        <documentation>No fim do mês é preciso lembrar quais dias foram feriado, ponto facultativo ou emenda.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Complexidade acidental do repositório" id="id-c2d0f93c58904c41b6c117736c2abe28">
        <documentation>Django, React, Flutter, orquestrador multi-CLI e restos de MongoDB convivem para um app de uma pessoa.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Folha oficial correta e no prazo" id="id-348da08faf98488db0b53b43f0be9bd8">
        <documentation>A empresa precisa da folha de papel preenchida, sem lacunas, no fim de cada mês.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Fim do mês exige garimpar conversas" id="id-8cf89bd0db604df8b362150c728a038a">
        <documentation>Juntar os horários vira um trabalho à parte, repetitivo e sujeito a erro (README).</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="App atual depende de servidor na rede de casa" id="id-b613954566224fa5a16efa6e32960121">
        <documentation>O web-app roda num celular velho com Termux; fora de casa, não abre.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Regras duplicadas em Python e Dart" id="id-a67132c932794f59941ef95199b52563">
        <documentation>calculate_status existe em services.py e em status.dart, mantidos juntos por vetores golden.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Sem backup dos dados" id="id-602c742c0ee642bd91308b03f550be0f">
        <documentation>Perder ou trocar o celular perde o histórico (consequência registrada no ADR-001).</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Preencher a folha do mês sem garimpo" id="id-ea70c0e8396b43adbb74a408a17900ff">
        <documentation>Ter tudo do mês num só lugar, na ordem da folha de papel.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Registrar o ponto na hora, em segundos" id="id-1cc47bc78c12437bad866efd6b229626">
        <documentation>A anotação acontece no momento do evento, com um toque.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Funcionar em qualquer rede, sem internet" id="id-829700b291384fe4806c6c23904d7eb0">
        <documentation>Inclusive dentro da rede da empresa.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Manter o projeto simples de evoluir" id="id-1f49c965545e47299b4d8c6075313583">
        <documentation>Uma pilha, poucos arquivos, testes rápidos. Fácil de estudar e de mudar.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Não perder o histórico" id="id-e4c5d1c45a184e5b83b0a3b1790e5763">
        <documentation>O usuário consegue guardar e restaurar os próprios dados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Folha copiada numa só sessão" id="id-a1c6808bbce5450081b365ed4211ff66">
        <documentation>Sem abrir o WhatsApp nem consultar outro calendário.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Nenhum dia útil esquecido" id="id-889e92964aeb4028a3aca1727fed4e53">
        <documentation>O app aponta todo dia útil sem lançamento ou incompleto.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Ponto batido no momento em que acontece" id="id-6d623836c1d5492da896d857e99c5815">
        <documentation>Em até 2 toques a partir do ícone do app.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Bater o ponto em até 2 toques" id="id-45d323fe31c3443e947abfa662d73919">
        <documentation>UC01, RNF04.</documentation>
        <property key="caso de uso" value="UC01" />
      </element>
      <element xsi:type="archimate:Requirement" name="Sugerir feriados e emendas automaticamente" id="id-1ff3545113af464986227f14fa384d76">
        <documentation>Nacionais e de SP pela lib holidays; Cubatão e emendas da empresa cadastrados. Emenda = folga.</documentation>
        <property key="caso de uso" value="UC03, UC06, UC10" />
      </element>
      <element xsi:type="archimate:Requirement" name="Listar as pendências do mês" id="id-95911b5ca53b44f884f876a508f7d13f">
        <documentation>Dia útil sem lançamento, lançamento incompleto, emenda a confirmar.</documentation>
        <property key="caso de uso" value="UC07" />
      </element>
      <element xsi:type="archimate:Requirement" name="Mostrar o mês na ordem da folha de papel" id="id-76a609054b01478cb8ea3a9b1ee4086b">
        <documentation>DIA · Manhã E/S · Tarde E/S · Extra E/S · observação, dias 01 a 31 corridos.</documentation>
        <property key="caso de uso" value="UC08" />
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar hora extra" id="id-12a5031c2a014bb596abed5e67c40142">
        <documentation>Par de marcações Extra (entrada/saída), como na folha oficial.</documentation>
        <property key="caso de uso" value="UC01, UC02" />
      </element>
      <element xsi:type="archimate:Requirement" name="Backup e restauração por arquivo" id="id-f8f1677c2cd54615bf77d1a023b6fce5">
        <documentation>JSON versionado, mesclar ou substituir.</documentation>
        <property key="caso de uso" value="UC09" />
      </element>
      <element xsi:type="archimate:Constraint" name="APK sem permissão de internet" id="id-c2b8ca856c624a86a53d44b4166bbc40">
        <documentation>RNF01. Um teste reprova qualquer import de rede.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Python ≥ 3.12 gerenciado com uv" id="id-218eebeaff7e4a51902ebae0a1065db8">
        <documentation>RNF02. Decisão do usuário.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Folha oficial em papel, preenchida à mão" id="id-d36bc4e1711d481a96d31beaf7cef6dc">
        <documentation>O app não substitui a folha: ele organiza o que vai ser copiado para ela.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-3d5882e67b4d43828f952ae0259229f2" type="implementation_migration">
    <folder name="E-F. Roadmap" id="id-bf1d4ea28ac744e4841366b25e97882e">
      <element xsi:type="archimate:Plateau" name="Baseline (nov/2026)" id="id-ddc2e08db90b4945b90d1331df9cf93a">
        <documentation>Três pilhas, servidor no celular velho, rede de casa.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 1: núcleo Python testado" id="id-ba93d4a80b2145789934c8e244375600">
        <documentation>Domínio, calendário e SQLite com pytest; uma CLI mínima no PC já registra e mostra a folha.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Transição 2: app Flet no PC" id="id-88b5e683e5454fa6858a1b7444b32d22">
        <documentation>Mesmas telas do celular rodando com `uv run`.</documentation>
      </element>
      <element xsi:type="archimate:Plateau" name="Target: APK offline no celular" id="id-396a10b6b3234211b709e3ba32367d1f">
        <documentation>App instalado, sem rede, com backup.</documentation>
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar servidor, API e API key" id="id-39aeea93a8064904902cd8b54fb7850d">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar React, Flutter e regras em Dart" id="id-edec3a51553b48b1b5973b9bc394292c">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar orquestrador, skills e Mongo/Docker" id="id-528351b3b1ff4053859324ab24f173e5">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Manter regras de status e vocabulário" id="id-9552ee50cc4544bd8ef8fb04e79bea9b">
        <documentation>Operação: keep.</documentation>
        <property key="operacao" value="keep" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar app Python offline com SQLite" id="id-4b1cb41d5363483ba5317acd061763d8">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar calendário de feriados e emendas" id="id-8a1b4a2d69d148a0a98d2768f3ae3971">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar fechamento do mês (pendências + folha)" id="id-13782097867d442d879910c10a26c6e4">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Criar backup e restauração" id="id-d596119a770045d7a7f8e40ac629842e">
        <documentation>Operação: create.</documentation>
        <property key="operacao" value="create" />
      </element>
      <element xsi:type="archimate:Gap" name="Eliminar anotações no WhatsApp" id="id-f2feabe899ac4406a379dd6f993c5788">
        <documentation>Operação: eliminate.</documentation>
        <property key="operacao" value="eliminate" />
      </element>
      <element xsi:type="archimate:Gap" name="Trocar a pesquisa de feriados por sugestão do app" id="id-46429c7c0f664818927e96dd72254ae9">
        <documentation>Operação: eliminate + create.</documentation>
        <property key="operacao" value="eliminate + create" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP1 Limpar o repositório" id="id-01bef7bb53e747ad82df35db4549093c">
        <documentation>Remover Django, React, Flutter, orquestrador, skills, Mongo/Docker. Escrever o ADR-002.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP2 Domínio + contrato em Python" id="id-7151b59d134447a39bf6d016ed2da19b">
        <documentation>Status, validação, ordem, horas e extra; vetores golden em pytest.</documentation>
        <property key="status" value="concluído em 2026-11-05" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP3 Repositório SQLite" id="id-d08bedbc9101495dad19751bf8035662">
        <documentation>Schema, migrações e upsert por data.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP4 Calendário" id="id-d9f1f8bbb6474fb990553d3bcbe0d2a5">
        <documentation>lib holidays BR/SP, regra de emenda, datas de Cubatão.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP5 Telas Flet" id="id-f8bc798ee0104ba9a59466cd45c94882">
        <documentation>Hoje (bater ponto), Mês, Folha, Ajustes.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP6 Exportação e backup" id="id-e7ac7ef6df4945e6bc6dc9ef6ad1eab9">
        <documentation>Folha em texto/CSV, backup/restauração JSON.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:WorkPackage" name="WP7 APK e CI" id="id-d1d402bed8414128a593514017cc92b1">
        <documentation>flet build apk, teste de não-rede, workflow único.</documentation>
        <property key="status" value="a fazer" />
      </element>
      <element xsi:type="archimate:Deliverable" name="Repositório limpo + ADR-002" id="id-2693139b93d146679996ac76bf396e36">
        <documentation>README, CLAUDE.md e docs atualizados.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="Pacote folha_ponto testado" id="id-e706849875a347c59ea0bfd1aa4f205c">
        <documentation>Domínio, calendário e SQLite com pytest verde.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="App Flet funcional no PC" id="id-645966f2e51e4f36badbf64d0e7045b6">
        <documentation>Todos os casos de uso navegáveis.</documentation>
      </element>
      <element xsi:type="archimate:Deliverable" name="APK offline + CI" id="id-6d61a60e583d460c8118b0853bfe3e0f">
        <documentation>Instalável no celular.</documentation>
      </element>
    </folder>
  </folder>
