    <folder name="D - Technology" id="id-7980d931a8dd455a9bc87b39cba69a3b">
      <element xsi:type="archimate:ArchimateDiagramModel" name="1. Baseline - tecnologia atual" id="id-8cb530b07bc14ce8a9d384eeea6e2e6a">
        <documentation>O app só funciona na Wi-Fi de casa, servido por um celular velho.</documentation>
