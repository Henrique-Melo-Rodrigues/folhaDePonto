    <folder name="D - Technology" id="id-8072abdcbb2249ef97b17fa292f80a92">
      <element xsi:type="archimate:ArchimateDiagramModel" name="1. Baseline - tecnologia atual" id="id-22b2ffd4e38b4ae099b97fb3567d04bc">
        <documentation>O app só funciona na Wi-Fi de casa, servido por um celular velho.</documentation>
